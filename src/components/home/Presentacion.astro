---
import Imagen from './Imagen.astro'
import { medidasImagen } from '../../lib/sanity.js'

const { proyectos = [], artista, vimeo = '' } = Astro.props
const retrato = artista?.retrato
const bio = artista?.bioCorta || ''
const tieneRetrato = Boolean(retrato?.asset)

// Con videos, la banda muestra la portada real del más reciente. Sin videos, la imagen de la página
// Audiovisual como registro de proceso: no se presenta como portada de ningún video.
const [video] = proyectos
const fondo = artista?.heroAudiovisual?.imagen
const tieneFondo = Boolean(fondo?.asset)
const bajadaAudiovisual = artista?.heroAudiovisual?.bajada?.trim() || ''

// Ninguna imagen se muestra más ancha que su resolución original.
const anchoFondo = tieneFondo ? medidasImagen(fondo).ancho : 0
const anchoRetrato = tieneRetrato ? medidasImagen(retrato).ancho : 0
const hayAudiovisual = Boolean(video) || tieneFondo || Boolean(vimeo)

function textoDuracion(duracion) {
	const valor = String(duracion || '').trim()
	if (!valor) return ''
	return valor.includes(':') ? valor : `${valor} min`
}

const fichaVideo = video ? [video.anio, textoDuracion(video.duracion)].filter(Boolean).join(' · ') : ''
---

{
	hayAudiovisual && (
		<section class="cine" aria-labelledby="cine-titulo">
			<div class="cine__texto fade-in">
				<div class="cine__encabezado">
					<p class="label cine__label">Imagen en movimiento</p>
					<h2 id="cine-titulo" class="titulo-seccion">
						Audiovisual
					</h2>
					{bajadaAudiovisual && <p class="cine__bajada">{bajadaAudiovisual}</p>}
				</div>
				<div class="cine__enlaces">
					<a class="enlace" href="/audiovisual">
						Ver sección audiovisual <span class="arrow" aria-hidden="true">→</span>
					</a>
					{vimeo && (
						<a class="enlace" href={vimeo} target="_blank" rel="noopener noreferrer">
							Canal en Vimeo <span aria-hidden="true">↗</span>
							<span class="sr-only">(se abre en otra pestaña)</span>
						</a>
					)}
				</div>
			</div>

			{video ? (
				<a class="cine__obra cine__obra--video fade-in" href="/audiovisual">
					<div class="cine__cuadro">
						{video.miniatura?.asset ? (
							<Imagen
								source={video.miniatura}
								alt={video.miniatura?.alt || video.titulo}
								width={1280}
								height={720}
								sizes="(min-width: 64rem) 58vw, 100vw"
							/>
						) : (
							video.miniaturaUrl && (
								<img src={video.miniaturaUrl} alt="" width="1280" height="720" loading="lazy" decoding="async" />
							)
						)}
						<span class="cine__play" aria-hidden="true">
							<svg viewBox="0 0 48 48">
								<circle cx="24" cy="24" r="21" />
								<path d="M20 16.5 32 24 20 31.5Z" />
							</svg>
						</span>
					</div>
					<p class="cine__pie">
						<span class="cine__titulo titulo-obra">{video.titulo}</span>
						{fichaVideo && <span class="cine__meta">{fichaVideo}</span>}
						<span class="sr-only">— reproducir en la sección audiovisual</span>
					</p>
				</a>
			) : (
				tieneFondo && (
					<figure class="cine__obra fade-in" style={`--ancho-natural: ${anchoFondo}px`}>
						<div class="cine__cuadro">
							<Imagen
								source={fondo}
								alt={fondo.alt || ''}
								width={1600}
								height={686}
								sizes="(min-width: 64rem) 58vw, 100vw"
							/>
						</div>
						{fondo.alt && <figcaption class="cine__pie cine__meta">{fondo.alt}</figcaption>}
					</figure>
				)
			)}
		</section>
	)
}

{
	(bio || tieneRetrato) && (
		<section class:list={['artista', !tieneRetrato && 'artista--sin-foto']} aria-labelledby="artista-titulo">
			<div class="artista__intro fade-in">
				<h2 id="artista-titulo" class="label">
					Sobre la artista
				</h2>
				{bio && <p class="artista__texto titulo-obra">{bio}</p>}
			</div>
			{tieneRetrato && (
				<figure class="artista__foto fade-in" style={`--ancho-natural: ${anchoRetrato}px`}>
					<Imagen
						source={retrato}
						alt={retrato.alt || artista?.nombre || ''}
						width={1000}
						sizes="(min-width: 64rem) 40vw, 82vw"
					/>
				</figure>
			)}
			<a class="enlace artista__enlace fade-in" href="/sobre-mi">
				Leer biografía <span class="arrow" aria-hidden="true">→</span>
			</a>
		</section>
	)
}

<style>
	/* Banda audiovisual: fondo carbón, texto a un lado y un único cuadro. */
	.cine {
		display: grid;
		gap: 2.25rem;
		margin-top: clamp(2.5rem, 5vw, 4.5rem);
		padding: clamp(3.5rem, 8vw, 4.5rem) var(--gutter);
		background-color: var(--color-dark);
		color: var(--color-bg);
	}

	.cine__texto,
	.cine__encabezado {
		display: grid;
		gap: 0.9rem;
		justify-items: start;
		align-content: start;
	}

	.cine__texto {
		gap: 1.75rem;
	}

	.cine__label,
	.cine__meta {
		color: rgba(248, 247, 245, 0.68);
	}

	.cine__bajada {
		max-width: 26rem;
		color: rgba(248, 247, 245, 0.85);
		line-height: 1.6;
	}

	.cine__enlaces {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
	}

	.cine__obra {
		display: block;
		min-width: 0;
		max-width: var(--ancho-natural, none);
		margin: 0 calc(-1 * var(--gutter));
		color: inherit;
		text-decoration: none;
	}

	.cine__cuadro {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		background-color: #222;
	}

	.cine__cuadro > img,
	.cine__cuadro :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition:
			opacity 0.8s var(--ease),
			transform 1.2s var(--ease);
	}

	.cine__play {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		color: #fff;
		pointer-events: none;
	}

	.cine__play svg {
		width: 3.5rem;
		height: 3.5rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.25;
	}

	.cine__pie {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.35rem 1.5rem;
		margin-top: 0.9rem;
		padding-inline: var(--gutter);
		font-size: 0.875rem;
		line-height: 1.45;
	}

	.cine__titulo {
		font-size: 1.375rem;
		line-height: 1.2;
	}

	.cine__obra--video:focus-visible {
		outline: 1px solid #fff;
		outline-offset: 4px;
	}

	@media (hover: hover) and (pointer: fine) {
		.cine__obra--video:hover .cine__cuadro :global(img),
		.cine__obra--video:hover .cine__cuadro > img {
			opacity: 0.8;
			transform: scale(1.015);
		}
	}

	@media (min-width: 48rem) {
		.cine__obra {
			margin-inline: 0;
		}

		.cine__pie {
			padding-inline: 0;
		}

		.cine__cuadro {
			aspect-ratio: 21 / 9;
		}

		.cine__obra--video .cine__cuadro {
			aspect-ratio: 16 / 9;
		}
	}

	/* Escritorio: dos columnas; la banda nunca supera el 70 % del alto de la pantalla. */
	@media (min-width: 64rem) {
		.cine {
			--relleno: clamp(2.5rem, 6svh, 4rem);
			grid-template-columns: repeat(12, minmax(0, 1fr));
			column-gap: 1.5rem;
			align-items: stretch;
			padding-block: var(--relleno);
		}

		.cine__texto {
			grid-column: 1 / 5;
			align-content: space-between;
		}

		.cine__obra {
			grid-column: 5 / -1;
			justify-self: end;
			width: 100%;
		}

		.cine__cuadro,
		.cine__obra--video .cine__cuadro {
			aspect-ratio: auto;
			height: min(calc(70svh - 2 * var(--relleno) - 2.75rem), 34rem);
		}

		.cine__enlaces {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	/* Sobre la artista: fotografía grande y texto breve, en composición asimétrica. */
	.artista {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		grid-template-areas:
			'intro'
			'foto'
			'enlace';
		padding: var(--seccion) var(--gutter);
	}

	.artista__intro {
		grid-area: intro;
	}

	.artista__texto {
		margin-top: 1.25rem;
		font-size: clamp(1.625rem, 2.6vw, 2.375rem);
		line-height: 1.16;
		text-wrap: pretty;
	}

	.artista__foto {
		grid-area: foto;
		width: 82%;
		max-width: var(--ancho-natural, none);
		margin: 2.5rem 0 0 auto;
		background-color: var(--color-surface);
	}

	.artista__enlace {
		grid-area: enlace;
		justify-self: start;
		margin-top: 2rem;
	}

	.artista--sin-foto .artista__intro {
		max-width: 48rem;
	}

	@media (min-width: 48rem) {
		.artista__foto {
			width: 64%;
		}
	}

	@media (min-width: 64rem) {
		.artista {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			grid-template-rows: minmax(0, 1fr) auto;
			grid-template-areas: none;
			column-gap: 1.5rem;
		}

		.artista__foto {
			grid-column: 1 / 6;
			grid-row: 1 / span 2;
			width: 100%;
			margin: 0;
		}

		.artista__intro {
			grid-column: 7 / -1;
			grid-row: 1;
			align-self: end;
		}

		.artista__enlace {
			grid-column: 7 / -1;
			grid-row: 2;
			align-self: end;
			margin-top: 2.5rem;
		}

		.artista--sin-foto .artista__intro,
		.artista--sin-foto .artista__enlace {
			grid-column: 4 / -2;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cine__cuadro :global(img),
		.cine__cuadro > img {
			transition: none;
		}
	}
</style>
