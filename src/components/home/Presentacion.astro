---
import Imagen from './Imagen.astro'
import Trazo from '../layout/Trazo.astro'

const { proyectos = [], artista, vimeo = '' } = Astro.props
const retrato = artista?.retrato
const bio = artista?.bioCorta || ''
const tieneRetrato = Boolean(retrato?.asset)

// Con videos, la sección muestra la portada real del más reciente. Sin videos, la imagen de la página
// Audiovisual como registro de proceso: no se presenta como portada de ningún video.
const [video] = proyectos
const fondo = artista?.heroAudiovisual?.imagen
const tieneFondo = Boolean(fondo?.asset)
const bajadaAudiovisual = artista?.heroAudiovisual?.bajada?.trim() || ''
const hayAudiovisual = Boolean(video) || tieneFondo || Boolean(vimeo)
const hayArtista = Boolean(bio) || tieneRetrato

function textoDuracion(duracion) {
	const valor = String(duracion || '').trim()
	if (!valor) return ''
	return valor.includes(':') ? valor : `${valor} min`
}

const fichaVideo = video ? [video.anio, textoDuracion(video.duracion)].filter(Boolean).join(' · ') : ''
---

{
	hayAudiovisual && (
		<section class="cine contenedor grilla" aria-labelledby="cine-titulo">
			<div class="cine__texto fade-in">
				<div class="cine__encabezado">
					<p class="label">Imagen en movimiento</p>
					<h2 id="cine-titulo" class="titulo-seccion">
						Audiovisual
					</h2>
					{bajadaAudiovisual && <p class="cine__bajada">{bajadaAudiovisual}</p>}
				</div>
				<div class="cine__enlaces">
					<a class="enlace" href="/audiovisual">
						Ver sección audiovisual <span class="arrow" aria-hidden="true">→</span>
					</a>
					{vimeo && (
						<a class="enlace" href={vimeo} target="_blank" rel="noopener noreferrer">
							Canal en Vimeo <span aria-hidden="true">↗</span>
							<span class="sr-only">(se abre en otra pestaña)</span>
						</a>
					)}
				</div>
			</div>

			{video ? (
				<a class="cine__obra cine__obra--video fade-in" href="/audiovisual">
					<div class="cine__cuadro">
						{video.miniatura?.asset ? (
							<Imagen
								source={video.miniatura}
								alt={video.miniatura?.alt || video.titulo}
								width={1280}
								height={720}
								sizes="(min-width: 64rem) min(66vw, 1110px), 100vw"
							/>
						) : (
							video.miniaturaUrl && (
								<img src={video.miniaturaUrl} alt="" width="1280" height="720" loading="lazy" decoding="async" />
							)
						)}
						<span class="cine__play" aria-hidden="true">
							<svg viewBox="0 0 48 48">
								<circle cx="24" cy="24" r="21" />
								<path d="M20 16.5 32 24 20 31.5Z" />
							</svg>
						</span>
					</div>
					<p class="cine__pie">
						<span class="cine__titulo titulo-obra">{video.titulo}</span>
						{fichaVideo && <span class="cine__meta">{fichaVideo}</span>}
						<span class="sr-only">— reproducir en la sección audiovisual</span>
					</p>
				</a>
			) : (
				tieneFondo && (
					<figure class="cine__obra fade-in">
						<div class="cine__cuadro">
							<Imagen
								source={fondo}
								alt={fondo.alt || ''}
								width={1600}
								height={686}
								sizes="(min-width: 64rem) min(66vw, 1110px), 100vw"
							/>
						</div>
						{fondo.alt && <figcaption class="cine__pie cine__meta">{fondo.alt}</figcaption>}
					</figure>
				)
			)}
		</section>
	)
}

{hayAudiovisual && hayArtista && <Trazo />}

{
	hayArtista && (
		<section class:list={['artista contenedor grilla', !tieneRetrato && 'artista--sin-foto']} aria-labelledby="artista-titulo">
			<div class="artista__intro fade-in">
				<h2 id="artista-titulo" class="label">
					Sobre la artista
				</h2>
				{bio && <p class="artista__texto titulo-obra">{bio}</p>}
			</div>
			{tieneRetrato && (
				<figure class="artista__foto fade-in">
					<Imagen
						source={retrato}
						alt={retrato.alt || artista?.nombre || ''}
						width={1000}
						sizes="(min-width: 64rem) min(42vw, 690px), 75vw"
					/>
				</figure>
			)}
			<a class="enlace artista__enlace fade-in" href="/sobre-mi">
				Leer biografía <span class="arrow" aria-hidden="true">→</span>
			</a>
		</section>
	)
}

<style>
	/* Audiovisual: texto a un lado y un único cuadro, sobre la grilla. */
	.cine {
		row-gap: 2.25rem;
	}

	.cine__texto,
	.cine__obra {
		grid-column: 1 / -1;
		min-width: 0;
	}

	.cine__texto,
	.cine__encabezado {
		display: grid;
		gap: 0.9rem;
		justify-items: start;
		align-content: start;
	}

	.cine__texto {
		gap: 1.75rem;
	}

	.cine__meta {
		color: var(--color-muted);
	}

	.cine__bajada {
		max-width: 26rem;
		line-height: 1.6;
	}

	.cine__enlaces {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
	}

	.cine__obra {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.cine__cuadro {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		background-color: var(--color-surface);
	}

	.cine__cuadro > img,
	.cine__cuadro :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition:
			opacity 0.8s var(--ease),
			transform 1.2s var(--ease);
	}

	.cine__play {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		color: var(--color-ink);
		pointer-events: none;
	}

	.cine__play svg {
		width: 3.5rem;
		height: 3.5rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.25;
		filter: drop-shadow(0 0 12px rgb(0 0 0 / 0.35));
	}

	.cine__pie {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.35rem 1.5rem;
		margin-top: 0.9rem;
		font-size: 0.875rem;
		line-height: 1.45;
	}

	.cine__titulo {
		font-size: 1.375rem;
		line-height: 1.2;
	}

	.cine__obra--video:focus-visible {
		outline: 1px solid var(--color-ink);
		outline-offset: 4px;
	}

	@media (hover: hover) and (pointer: fine) {
		.cine__obra--video:hover .cine__cuadro :global(img),
		.cine__obra--video:hover .cine__cuadro > img {
			opacity: 0.8;
			transform: scale(1.015);
		}
	}

	@media (min-width: 48rem) {
		.cine__cuadro {
			aspect-ratio: 21 / 9;
		}

		.cine__obra--video .cine__cuadro {
			aspect-ratio: 16 / 9;
		}
	}

	/* Escritorio: texto en las columnas 1–4, cuadro en las 5–12; no supera el 70 % del alto. */
	@media (min-width: 64rem) {
		.cine__texto {
			grid-column: 1 / 5;
			align-content: space-between;
		}

		.cine__obra {
			grid-column: 5 / 13;
		}

		.cine__cuadro,
		.cine__obra--video .cine__cuadro {
			aspect-ratio: auto;
			height: min(calc(70svh - 3rem), 34rem);
		}

		.cine__enlaces {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	/* Sobre la artista: fotografía grande y texto breve. */
	.artista {
		row-gap: 2.5rem;
	}

	.artista__intro,
	.artista__enlace {
		grid-column: 1 / -1;
	}

	.artista__foto {
		grid-column: 2 / -1;
		background-color: var(--color-surface);
	}

	.artista__enlace {
		justify-self: start;
	}

	.artista__texto {
		margin-top: 1.25rem;
		font-size: clamp(1.625rem, 2.4vw, 2.25rem);
		line-height: 1.16;
		text-wrap: pretty;
	}

	@media (min-width: 64rem) {
		.artista {
			grid-template-rows: minmax(0, 1fr) auto;
			row-gap: 2.5rem;
		}

		.artista__foto {
			grid-column: 1 / 6;
			grid-row: 1 / span 2;
		}

		.artista__intro {
			grid-column: 7 / 13;
			grid-row: 1;
			align-self: end;
		}

		.artista__enlace {
			grid-column: 7 / 13;
			grid-row: 2;
			align-self: end;
		}

		.artista--sin-foto .artista__intro,
		.artista--sin-foto .artista__enlace {
			grid-column: 1 / 9;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cine__cuadro :global(img),
		.cine__cuadro > img {
			transition: none;
		}
	}
</style>
