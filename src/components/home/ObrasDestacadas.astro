---
import Imagen from './Imagen.astro'
import { medidasImagen } from '../../lib/sanity.js'

const { destacadas = [], obra, whatsapp } = Astro.props

const estados = {
	disponible: { marca: '●', texto: 'Disponible' },
	reservada: { marca: '○', texto: 'Reservada' },
	vendida: { marca: '', texto: 'Vendida' },
}

function consultaWhatsapp(numero, titulo, anio) {
	const digitos = String(numero || '').replace(/\D/g, '')
	if (!digitos || !titulo) return ''
	const detalle = anio ? ` (${anio})` : ''
	const texto = `Hola, me interesa la obra '${titulo}'${detalle}. ¿Me pasás más info?`
	return `https://wa.me/${digitos}?text=${encodeURIComponent(texto)}`
}

// La obra principal (Configuración) abre la selección; si no hay, la primera destacada.
const principal = obra?.imagenPrincipal?.asset ? obra : null
const piezas = [principal, ...destacadas.filter((item) => item.slug !== principal?.slug)]
	.filter((item) => item?.imagenPrincipal?.asset)
	.slice(0, 5)
	.map((item, orden) => {
		const { ancho, alto } = medidasImagen(item.imagenPrincipal)
		return { ...item, orden, ancho, alto, horizontal: ancho > alto * 1.15 }
	})

/*
	Escritorio: dos pilas sobre la grilla de 12 columnas.
	Pila A (columnas 1–7): la protagonista en 1–7, las siguientes en 2–6.
	Pila B (columnas 8–12): la segunda en 9–12, alineada arriba con la protagonista; luego 8–12 y 9–12.
	Desde la tercera, cada obra va a la pila más corta, así ninguna deja un hueco.
	Si una imagen no alcanza su resolución real con el contenedor máximo (1680 px), pierde columnas.
*/
const ANCHO_MAX = 1680
const SEPARACION = 24
const COLUMNA = (ANCHO_MAX - 11 * SEPARACION) / 12
const PIE = 48
const ENTRE_OBRAS = 96
const anchoDe = (columnas) => columnas * COLUMNA + (columnas - 1) * SEPARACION

const pilas = [
	{ inicio: 1, alto: 0, piezas: [], lugares: [{ desde: 1, columnas: 7 }, { desde: 2, columnas: 5 }] },
	{
		inicio: 8,
		alto: 0,
		piezas: [],
		lugares: [{ desde: 9, columnas: 4 }, { desde: 8, columnas: 5 }, { desde: 9, columnas: 4 }],
	},
]

function ubicar(pieza, pila) {
	const cantidad = pila.piezas.length
	const lugar = cantidad === 0 ? pila.lugares[0] : pila.lugares[1 + ((cantidad - 1) % (pila.lugares.length - 1))]
	let columnas = lugar.columnas
	while (columnas > 3 && anchoDe(columnas) > pieza.ancho) columnas--
	pieza.columnaEscritorio = `${lugar.desde - pila.inicio + 1} / span ${columnas}`
	pila.alto += (cantidad ? ENTRE_OBRAS : 0) + (anchoDe(columnas) * pieza.alto) / pieza.ancho + PIE
	pila.piezas.push(pieza)
}

for (const pieza of piezas) {
	const destino = pieza.orden < 2 ? pilas[pieza.orden] : pilas[0].alto <= pilas[1].alto ? pilas[0] : pilas[1]
	ubicar(pieza, destino)
}

// Móvil (4 columnas): la primera y las horizontales a todo el ancho; las demás de a dos.
let pendiente = null
for (const pieza of piezas) {
	if (pieza.orden === 0 || pieza.horizontal) {
		pieza.columnaMovil = '1 / -1'
		continue
	}
	if (pendiente) {
		pendiente.columnaMovil = '1 / 3'
		pieza.columnaMovil = '3 / 5'
		pendiente = null
	} else {
		pendiente = pieza
	}
}
if (pendiente) pendiente.columnaMovil = '2 / 5'

const estado = principal ? estados[principal.estado] || null : null
const meta = principal ? [principal.anio, principal.tecnica, principal.dimensiones].filter(Boolean).join(' · ') : ''
const linkConsulta = principal ? consultaWhatsapp(whatsapp, principal.titulo, principal.anio) : ''
---

{
	piezas.length > 0 && (
		<section class="seleccion contenedor" aria-labelledby="seleccion-titulo">
			<header class="seleccion__cabecera grilla fade-in">
				<p class="label seleccion__label">Obras</p>
				<h2 id="seleccion-titulo" class="titulo-seccion seleccion__titulo">
					Selección de obra
				</h2>
				<a class="enlace seleccion__todas" href="/obras">
					Ver todas las obras <span class="arrow" aria-hidden="true">→</span>
				</a>
			</header>

			<div class="seleccion__grilla grilla">
				{pilas.map((pila, numero) =>
					pila.piezas.length > 0 && (
						<div class:list={['seleccion__pila', numero === 0 ? 'seleccion__pila--a' : 'seleccion__pila--b']}>
							{pila.piezas.map((pieza) => {
								const esPrincipal = pieza.orden === 0 && Boolean(principal)
								return (
									<article
										class="pieza fade-in"
										style={`--orden: ${pieza.orden}; --columna: ${pieza.columnaEscritorio}; --columna-movil: ${pieza.columnaMovil}`}
									>
										<a class="pieza__enlace" href={pieza.slug ? `/obras/${pieza.slug}` : '/obras'}>
											<div class="pieza__marco">
												<Imagen
													source={pieza.imagenPrincipal}
													transicion={pieza.slug ? `obra-${pieza.slug}` : ''}
													alt={pieza.imagenPrincipal?.alt || pieza.titulo}
													width={pieza.orden === 0 ? 1200 : 900}
													sizes={
														pieza.columnaMovil === '1 / -1'
															? '(min-width: 64rem) min(58vw, 970px), 100vw'
															: '(min-width: 64rem) min(42vw, 690px), 50vw'
													}
												/>
											</div>
											<h3 class="pieza__pie">
												<span class="pieza__titulo titulo-obra">{pieza.titulo}</span>
												{pieza.anio && <span class="pieza__anio">, {pieza.anio}</span>}
											</h3>
										</a>
										{esPrincipal && (meta || estado || linkConsulta) && (
											<div class="pieza__ficha">
												{meta && <p class="pieza__meta">{meta}</p>}
												{estado && (
													<p class="pieza__estado">
														{estado.marca && <span aria-hidden="true">{estado.marca}</span>}
														{estado.texto}
													</p>
												)}
												{linkConsulta && (
													<a class="enlace" href={linkConsulta} target="_blank" rel="noopener noreferrer">
														{estado ? 'Consultar por esta obra' : 'Consultar sobre esta obra'}{' '}
														<span class="arrow" aria-hidden="true">→</span>
													</a>
												)}
											</div>
										)}
									</article>
								)
							})}
						</div>
					),
				)}
			</div>
		</section>
	)
}

<style>
	.seleccion {
		--entre-obras: 3rem;
	}

	.seleccion__cabecera {
		row-gap: 0.9rem;
		margin-bottom: 3rem;
	}

	.seleccion__label,
	.seleccion__titulo,
	.seleccion__todas {
		grid-column: 1 / -1;
		justify-self: start;
	}

	/* Móvil: las pilas desaparecen y las obras se ordenan en la grilla de 4 columnas. */
	.seleccion__grilla {
		row-gap: var(--entre-obras);
		align-items: start;
	}

	.seleccion__pila {
		display: contents;
	}

	.pieza {
		grid-column: var(--columna-movil);
		order: var(--orden);
		min-width: 0;
	}

	.pieza__enlace {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.pieza__marco {
		background-color: var(--color-surface);
	}

	.pieza__marco :global(img) {
		transition: opacity 0.6s var(--ease);
	}

	.pieza__pie {
		margin-top: 0.8rem;
		font-family: var(--font-body);
		font-size: 0.875rem;
		font-weight: 400;
		line-height: 1.4;
		letter-spacing: 0;
	}

	.pieza__titulo {
		font-size: 1.1875rem;
		line-height: 1.2;
		background-image: linear-gradient(currentColor, currentColor);
		background-position: 0 100%;
		background-repeat: no-repeat;
		background-size: 0 1px;
		transition: background-size 0.5s var(--ease);
	}

	.pieza__anio {
		color: var(--color-muted);
	}

	.pieza__ficha {
		display: grid;
		gap: 0.6rem;
		justify-items: start;
		margin-top: 0.6rem;
	}

	.pieza__meta {
		color: var(--color-muted);
		font-size: 0.875rem;
	}

	.pieza__estado {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.875rem;
	}

	.pieza__enlace:hover .pieza__titulo,
	.pieza__enlace:focus-visible .pieza__titulo {
		background-size: 100% 1px;
	}

	.pieza__enlace:focus-visible {
		outline: 1px solid var(--color-ink);
		outline-offset: 6px;
	}

	@media (hover: hover) and (pointer: fine) {
		.pieza__enlace:hover .pieza__marco :global(img) {
			opacity: 0.85;
		}
	}

	/* Escritorio: dos pilas que son subgrillas de la grilla de 12 columnas. */
	@media (min-width: 64rem) {
		.seleccion {
			--entre-obras: 6rem;
		}

		.seleccion__cabecera {
			align-items: last baseline;
			margin-bottom: 4.5rem;
		}

		.seleccion__label {
			grid-row: 1;
		}

		.seleccion__titulo {
			grid-column: 1 / 10;
			grid-row: 2;
		}

		.seleccion__todas {
			grid-column: 10 / 13;
			grid-row: 2;
			justify-self: end;
		}

		.seleccion__pila {
			display: grid;
			grid-template-columns: subgrid;
			align-content: start;
			row-gap: var(--entre-obras);
		}

		.seleccion__pila--a {
			grid-column: 1 / 8;
		}

		.seleccion__pila--b {
			grid-column: 8 / 13;
		}

		.pieza {
			grid-column: var(--columna);
		}

		.seleccion__pila--a .pieza:first-child .pieza__titulo {
			font-size: 1.375rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pieza__marco :global(img),
		.pieza__titulo {
			transition: none;
		}
	}
</style>
