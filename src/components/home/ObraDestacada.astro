---
import Imagen from './Imagen.astro'
import Flecha from '../layout/Flecha.astro'

/*
	Banda azul de la obra destacada del Inicio: una obra con nombre, formada por cuadros.
	obra: salida de fetchSeriePrincipal() (tipo interno "serie"; en la web se habla de obras y cuadros).
	La portada puede recortarse con su punto de interés porque es una portada, no el cuadro completo.
	La tira de miniaturas muestra los cuadros en su proporción real y aparece cuando hay al menos dos con foto.
*/
const { obra } = Astro.props
const cuadros = obra?.cuadros || []
const meta = obra && obra.cantidadObras > 0 ? `${obra.cantidadObras} ${obra.cantidadObras === 1 ? 'cuadro' : 'cuadros'}` : ''
const metaLinea = obra ? [obra.anio, meta].filter(Boolean).join(' · ') : ''
---

{
	obra && (
		<section class="destacada contenedor" aria-labelledby="destacada-titulo">
			<div class:list={['destacada__banda ctx-azul ctx-azul--profundo textura textura--sutil fade-in', !obra.portada && 'destacada__banda--sin-imagen']}>
				{obra.portada && (
					<div class="destacada__imagen">
						<Imagen
							source={obra.portada}
							alt={obra.portada.alt || obra.nombre}
							width={1200}
							height={640}
							sizes="(min-width: 64rem) min(58vw, 960px), 100vw"
						/>
					</div>
				)}
				<div class="destacada__texto">
					<p class="label label--acento">Obra destacada</p>
					<h2 id="destacada-titulo" class="t-display destacada__nombre">
						{obra.nombre}
					</h2>
					{obra.descripcion && <p class="t-texto destacada__descripcion">{obra.descripcion}</p>}
					{metaLinea && <p class="label destacada__meta">{metaLinea}</p>}
					{cuadros.length > 1 && (
						<ul class="destacada__cuadros" aria-label={`Cuadros de ${obra.nombre}`}>
							{cuadros.map((cuadro) => (
								<li class="destacada__cuadro">
									<a href={cuadro.href} aria-label={cuadro.titulo}>
										{cuadro.imagen && <Imagen source={cuadro.imagen} alt={cuadro.imagen.alt || cuadro.titulo} width={220} sizes="110px" />}
									</a>
								</li>
							))}
						</ul>
					)}
					<a class="btn btn-contorno destacada__boton" href={obra.href}>
						Ver obra
						<Flecha />
					</a>
				</div>
			</div>
		</section>
	)
}

<style>
	.destacada {
		padding-top: var(--bloque);
	}

	.destacada__banda {
		display: grid;
		overflow: hidden;
	}

	/* Móvil: portada arriba, fundida hacia abajo. */
	.destacada__imagen {
		position: relative;
		aspect-ratio: 4 / 3;
		-webkit-mask-image: var(--mascara-abajo);
		mask-image: var(--mascara-abajo);
		-webkit-mask-size: 100% 100%;
		mask-size: 100% 100%;
	}

	.destacada__imagen :global(.lqip) {
		position: absolute;
		inset: 0;
	}

	.destacada__imagen :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.destacada__texto {
		display: grid;
		justify-items: start;
		align-content: center;
		padding: 0.5rem 1.5rem 2.5rem;
	}

	.destacada__nombre {
		margin-top: 0.6rem;
		color: var(--blanco-calido);
		font-size: clamp(2.5rem, 4.2vw, 4.25rem);
		text-transform: uppercase;
	}

	.destacada__descripcion {
		max-width: 30rem;
		margin-top: 1rem;
		color: var(--blanco-calido);
	}

	.destacada__meta {
		margin-top: 1rem;
	}

	/* Tira de miniaturas: los cuadros de la obra, completos, en su proporción y a la misma altura. */
	.destacada__cuadros {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
	}

	.destacada__cuadro a {
		position: relative;
		display: block;
		height: 4.5rem;
	}

	.destacada__cuadro a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.45rem;
		height: 1px;
		background-color: var(--dorado);
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform 0.3s var(--ease);
	}

	.destacada__cuadro a:hover::after,
	.destacada__cuadro a:focus-visible::after {
		transform: scaleX(1);
	}

	.destacada__cuadro a:focus-visible {
		outline: 1px solid var(--blanco-calido);
		outline-offset: 3px;
	}

	.destacada__cuadro :global(.lqip),
	.destacada__cuadro :global(img) {
		height: 100%;
		width: auto;
	}

	.destacada__boton {
		margin-top: 1.75rem;
	}

	.destacada__banda--sin-imagen .destacada__texto {
		padding-top: 2.5rem;
	}

	/* Escritorio: portada en el 60 % izquierdo, fundida hacia la derecha con borde irregular. */
	@media (min-width: 64rem) {
		.destacada__banda {
			grid-template-columns: 60fr 40fr;
			min-height: 25rem;
		}

		.destacada__imagen {
			aspect-ratio: auto;
			margin-right: -6%;
			-webkit-mask-image: var(--mascara-derecha);
			mask-image: var(--mascara-derecha);
		}

		.destacada__texto {
			position: relative;
			padding: 3rem clamp(2rem, 4vw, 4rem) 3rem 1.5rem;
		}

		.destacada__banda--sin-imagen {
			grid-template-columns: 1fr;
		}

		.destacada__banda--sin-imagen .destacada__texto {
			padding: 3.5rem clamp(2rem, 6vw, 6rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.destacada__cuadro a::after {
			transition: none;
		}
	}
</style>
