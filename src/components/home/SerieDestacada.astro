---
import Imagen from './Imagen.astro'
import Flecha from '../layout/Flecha.astro'

// serie: salida de fetchSeriePrincipal() (la marcada como "Serie principal del Inicio").
// La portada puede recortarse con su punto de interés porque es una portada, no la obra completa.
const { serie } = Astro.props
const meta = serie
	? [serie.anio, serie.cantidadObras > 0 && `${serie.cantidadObras} ${serie.cantidadObras === 1 ? 'obra' : 'obras'}`]
			.filter(Boolean)
			.join(' · ')
	: ''
---

{
	serie && (
		<section class="destacada contenedor" aria-labelledby="destacada-titulo">
			<div class:list={['destacada__banda ctx-azul ctx-azul--profundo textura textura--sutil fade-in', !serie.portada && 'destacada__banda--sin-imagen']}>
				{serie.portada && (
					<div class="destacada__imagen">
						<Imagen
							source={serie.portada}
							alt={serie.portada.alt || serie.nombre}
							width={1200}
							height={640}
							sizes="(min-width: 64rem) min(58vw, 960px), 100vw"
						/>
					</div>
				)}
				<div class="destacada__texto">
					<p class="label label--acento">Serie destacada</p>
					<h2 id="destacada-titulo" class="t-display destacada__nombre">
						{serie.nombre}
					</h2>
					{serie.descripcion && <p class="t-texto destacada__descripcion">{serie.descripcion}</p>}
					{meta && <p class="label destacada__meta">{meta}</p>}
					<a class="btn btn-contorno destacada__boton" href={serie.href}>
						Ver serie
						<Flecha />
					</a>
				</div>
			</div>
		</section>
	)
}

<style>
	.destacada {
		padding-top: var(--bloque);
	}

	.destacada__banda {
		display: grid;
		overflow: hidden;
	}

	/* Móvil: portada arriba, fundida hacia abajo. */
	.destacada__imagen {
		position: relative;
		aspect-ratio: 4 / 3;
		-webkit-mask-image: var(--mascara-abajo);
		mask-image: var(--mascara-abajo);
		-webkit-mask-size: 100% 100%;
		mask-size: 100% 100%;
	}

	.destacada__imagen :global(.lqip) {
		position: absolute;
		inset: 0;
	}

	.destacada__texto {
		display: grid;
		justify-items: start;
		align-content: center;
		padding: 0.5rem 1.5rem 2.5rem;
	}

	.destacada__nombre {
		margin-top: 0.6rem;
		color: var(--blanco-calido);
		font-size: clamp(2.5rem, 4.2vw, 4.25rem);
		text-transform: uppercase;
	}

	.destacada__descripcion {
		max-width: 30rem;
		margin-top: 1rem;
		color: var(--blanco-calido);
	}

	.destacada__meta {
		margin-top: 1rem;
	}

	.destacada__boton {
		margin-top: 1.75rem;
	}

	.destacada__banda--sin-imagen .destacada__texto {
		padding-top: 2.5rem;
	}

	/* Escritorio: portada en el 60 % izquierdo, fundida hacia la derecha con borde irregular. */
	@media (min-width: 64rem) {
		.destacada__banda {
			grid-template-columns: 60fr 40fr;
			min-height: 25rem;
		}

		.destacada__imagen {
			aspect-ratio: auto;
			margin-right: -6%;
			-webkit-mask-image: var(--mascara-derecha);
			mask-image: var(--mascara-derecha);
		}

		.destacada__texto {
			position: relative;
			padding: 3rem clamp(2rem, 4vw, 4rem) 3rem 1.5rem;
		}

		.destacada__banda--sin-imagen {
			grid-template-columns: 1fr;
		}

		.destacada__banda--sin-imagen .destacada__texto {
			padding: 3.5rem clamp(2rem, 6vw, 6rem);
		}
	}
</style>
