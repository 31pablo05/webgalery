---
import {medidasImagen, urlFor} from '../../lib/sanity.js'

// Con width y height, la imagen se recorta a ese formato (respetando el hotspot de Sanity).
// Solo con width, se muestra entera con su proporción original: es lo que usan las obras.
// Mientras carga, se ve la versión borrosa (LQIP) sobre el color dominante de la imagen.
const {
	source,
	width: anchoPedido,
	height,
	sizes,
	priority = false,
	class: clase = '',
	// Nombre de View Transition: la misma obra se transforma con continuidad entre páginas.
	transicion = '',
} = Astro.props

const alt = Astro.props.alt || source?.alt || ''
const tieneArchivo = Boolean(source?.asset)
const natural = !height
const medidas = natural && tieneArchivo ? medidasImagen(source) : null
// Nunca se pide ni se declara una versión más ancha que la imagen real.
const width = medidas ? Math.min(anchoPedido, medidas.ancho) : anchoPedido
const alto = natural ? (medidas ? Math.round((width * medidas.alto) / medidas.ancho) : width) : height

function url(ancho, altoPedido) {
	const cadena = urlFor(source).width(ancho)
	return (natural ? cadena : cadena.height(altoPedido)).url()
}

const src = tieneArchivo ? url(width, alto) : ''
const chico = Math.round(width / 2)
const altoChico = Math.round((alto * chico) / width)
const srcChico = tieneArchivo ? url(chico, altoChico) : ''
const srcset = srcChico && srcChico !== src ? `${srcChico} ${chico}w, ${src} ${width}w` : undefined

const metadata = source?.asset?.metadata
const lqip = metadata?.lqip || ''
const dominante = metadata?.palette?.dominant?.background || ''
// Al recortar, el encuadre se centra en el punto de interés (hotspot) que se marca en Sanity.
const hotspot = source?.hotspot
const posicion =
	!natural && hotspot && Number.isFinite(hotspot.x) && Number.isFinite(hotspot.y)
		? `object-position: ${(hotspot.x * 100).toFixed(1)}% ${(hotspot.y * 100).toFixed(1)}%`
		: ''
const estiloImagen = [posicion, transicion && `view-transition-name: ${transicion}`].filter(Boolean).join('; ') || undefined
const estilo = [dominante && `--dominante: ${dominante}`, lqip && `--lqip: url("${lqip}")`]
	.filter(Boolean)
	.join('; ')
---

{
	tieneArchivo && (
		<span class:list={['lqip', natural ? 'lqip--natural' : 'lqip--cubre', clase]} style={estilo || undefined}>
			<img
				src={src}
				srcset={srcset}
				sizes={srcset ? sizes : undefined}
				alt={alt}
				width={width}
				height={alto}
				loading={priority ? 'eager' : 'lazy'}
				fetchpriority={priority ? 'high' : 'auto'}
				decoding={priority ? 'sync' : 'async'}
				data-nitida={priority ? undefined : ''}
				style={estiloImagen}
			/>
		</span>
	)
}
