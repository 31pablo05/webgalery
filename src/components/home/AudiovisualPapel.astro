---
import Imagen from './Imagen.astro'
import ObraPlaceholder from '../obras/ObraPlaceholder.astro'
import Flecha from '../layout/Flecha.astro'
import ReproducirVideo from './ReproducirVideo.jsx'
import { rutas } from '../../lib/rutas.js'

/*
	Dos bloques lado a lado (52/48): Audiovisual (azul) y Obras sobre papel (marfil).
	video: salida de fetchVideoReciente(), o null. Sin video, el bloque usa una foto de proceso
	(respaldo) y no muestra el botón de reproducir.
	papel: la disciplina "Obras sobre papel" (nombre, descripción, portada, href), o null.
*/
const { video = null, respaldo = null, textoAudiovisual = '', papel = null } = Astro.props

const portadaVideo = video?.miniatura?.src ? video.miniatura : video?.miniaturaUrl ? { src: video.miniaturaUrl, srcset: '', alt: '' } : null
const reproducible = Boolean(video?.vimeoId)
const datosVideo = reproducible ? { titulo: video.titulo, vimeoId: video.vimeoId, vimeoHash: video.vimeoHash } : null
---

<section class="dupla contenedor" aria-label="Audiovisual y obras sobre papel">
	<article class="bloque bloque--av ctx-azul ctx-azul--profundo textura textura--sutil fade-in" aria-labelledby="av-titulo">
		<div class="bloque__imagen bloque__imagen--fundida" data-marco-caja={portadaVideo ? '' : undefined}>
			{
				portadaVideo ? (
					<>
						<img
							src={portadaVideo.src}
							srcset={portadaVideo.srcset || undefined}
							sizes="(min-width: 64rem) 30vw, 100vw"
							alt={portadaVideo.alt || `Fotograma de ${video.titulo}`}
							width="1280"
							height="720"
							loading="lazy"
							decoding="async"
							data-marco
						/>
						<ObraPlaceholder
							class="marco__pendiente marco__pendiente--espera"
							llenar
							proporcion="horizontal"
							titulo={video.titulo}
						/>
					</>
				) : (
					<Imagen
						source={respaldo}
						alt={respaldo?.alt || 'Audiovisual'}
						titulo="Audiovisual"
						width={900}
						height={640}
						marco="audiovisual"
						proporcion="horizontal"
						sizes="(min-width: 64rem) 30vw, 100vw"
					/>
				)
			}
			{reproducible && <ReproducirVideo client:visible video={datosVideo} />}
		</div>
		<div class="bloque__texto">
			<h2 id="av-titulo" class="t-display bloque__nombre">Audiovisual</h2>
			{textoAudiovisual && <p class="t-texto bloque__descripcion">{textoAudiovisual}</p>}
			<a class="btn btn-contorno bloque__boton" href={rutas.audiovisual}>
				Ver audiovisual
				<Flecha />
			</a>
		</div>
	</article>

	{
		papel && (
			<article class="bloque bloque--papel ctx-marfil fade-in" aria-labelledby="papel-titulo">
				<div class="bloque__imagen">
					<Imagen
						source={papel.portada}
						alt={papel.portada?.alt || papel.nombre}
						titulo={papel.nombre}
						width={800}
						height={600}
						marco="portada"
						proporcion="horizontal"
						sizes="(min-width: 64rem) 22vw, 100vw"
					/>
				</div>
				<div class="bloque__texto">
					<h2 id="papel-titulo" class="t-display bloque__nombre">
						{papel.nombre}
					</h2>
					{papel.descripcion && <p class="t-texto bloque__descripcion">{papel.descripcion}</p>}
					<a class="btn btn-contorno bloque__boton" href={papel.href}>
						Explorar
						<Flecha />
					</a>
				</div>
			</article>
		)
	}
</section>

<style>
	.dupla {
		display: grid;
		align-items: start;
		gap: 1rem;
		padding-top: var(--bloque);
	}

	.bloque {
		display: grid;
		overflow: hidden;
	}

	.bloque__imagen {
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
	}

	.bloque--av .bloque__imagen {
		aspect-ratio: 2.2 / 1;
	}

	.bloque__nombre {
		color: inherit;
		font-size: clamp(2rem, 3vw, 2.75rem);
	}

	.bloque__imagen > img,
	.bloque__imagen :global(.marco) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Móvil: la imagen del bloque azul se funde hacia abajo. */
	.bloque__imagen--fundida {
		-webkit-mask-image: var(--mascara-abajo);
		mask-image: var(--mascara-abajo);
		-webkit-mask-size: 100% 100%;
		mask-size: 100% 100%;
	}

	.bloque__imagen:has(.is-vacia) {
		-webkit-mask-image: none;
		mask-image: none;
	}

	.bloque__texto {
		display: grid;
		justify-items: start;
		align-content: center;
		padding: 1.5rem 1.5rem 2rem;
	}

	.bloque--papel .bloque__texto {
		padding-top: 1.75rem;
	}

	.bloque__descripcion {
		max-width: 22rem;
		margin-top: 0.75rem;
	}

	.bloque__boton {
		margin-top: 1.5rem;
	}

	/* Botón de reproducir: círculo fino sobre la imagen (lo renderiza el island). */
	.bloque :global(.reproducir) {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 4rem;
		height: 4rem;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: none;
		color: var(--blanco-calido);
		cursor: pointer;
		translate: -50% -50%;
	}

	.bloque :global(.reproducir svg) {
		width: 100%;
		height: 100%;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.1;
		filter: drop-shadow(0 0 10px rgb(0 0 0 / 0.35));
		transition: transform 0.4s var(--ease);
	}

	.bloque :global(.reproducir:hover svg) {
		transform: scale(1.08);
	}

	.bloque :global(.reproducir:focus-visible) {
		outline: 1px solid var(--dorado);
		outline-offset: 4px;
	}

	/* Tablet: el audiovisual pone el fotograma a la izquierda, en su proporción. El papel apila la pieza. */
	@media (min-width: 48rem) {
		.bloque--av {
			grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.9fr);
			align-items: center;
		}

		.bloque--av .bloque__imagen {
			grid-column: 1;
			grid-row: 1;
			aspect-ratio: 2.2 / 1;
		}

		.bloque--av .bloque__texto {
			grid-column: 2;
			grid-row: 1;
			padding: 1.5rem 1.75rem 1.5rem 1.25rem;
		}

		.bloque--av .bloque__imagen--fundida {
			margin: 0;
			-webkit-mask-image: linear-gradient(90deg, #000 72%, transparent);
			mask-image: linear-gradient(90deg, #000 72%, transparent);
		}
	}

	@media (min-width: 64rem) {
		.dupla {
			grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
			gap: 1.25rem;
		}

		.dupla:has(> :only-child) {
			grid-template-columns: 1fr;
		}

		.bloque__texto {
			padding: 2rem 2rem 2.25rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.bloque :global(.reproducir svg) {
			transition: none;
		}
	}
</style>
