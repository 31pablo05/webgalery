---
// Frase introductoria del Inicio (editable desde los datos). Centrada, con líneas doradas a los lados.
const { frase = '' } = Astro.props
---

{
	frase && (
		<section class="frase ctx-marfil" aria-label="Presentación de la obra">
			<div class="frase__fila contenedor fade-in">
				<span class="frase__linea" aria-hidden="true" />
				<p class="frase__texto">{frase}</p>
				<span class="frase__linea" aria-hidden="true" />
			</div>
		</section>
	)
}

<style>
	.frase {
		padding-block: clamp(4.5rem, 9vw, 7.5rem);
	}

	.frase__fila {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 2.5rem;
	}

	.frase__linea {
		display: none;
		flex: 0 1 6.5rem;
		height: 1px;
		background-color: var(--dorado);
	}

	.frase__texto {
		max-width: 34rem;
		color: var(--tinta);
		font-family: var(--font-display);
		font-size: clamp(1.7rem, 1.2vw + 1.15rem, 2.35rem);
		font-style: italic;
		font-weight: 400;
		line-height: 1.3;
		letter-spacing: 0;
		text-align: center;
		text-wrap: balance;
	}

	@media (min-width: 64rem) {
		.frase__linea {
			display: block;
		}
	}
</style>
