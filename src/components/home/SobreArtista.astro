---
import Imagen from './Imagen.astro'
import Flecha from '../layout/Flecha.astro'
import { imagenDisponible } from '../../lib/sanity.js'
import { rutas } from '../../lib/rutas.js'

// Foto auténtica de la artista fundida con el fondo y la bio corta (docs/contenido-sobre-la-artista.md).
const { retrato = null, bio = '', nombre = '' } = Astro.props
const conFoto = imagenDisponible(retrato)
---

{
	(bio || conFoto) && (
		<section class:list={['artista ctx-claro', !conFoto && 'artista--sin-foto']} aria-labelledby="artista-titulo">
			{conFoto && (
				<div class="artista__foto">
					<Imagen
						source={retrato}
						alt={retrato.alt || nombre}
						width={1000}
						height={720}
						sizes="(min-width: 64rem) 46vw, 100vw"
					/>
				</div>
			)}
			<div class="artista__texto contenedor fade-in">
				<div class="artista__columna">
					<div class="encabezado-seccion">
						<h2 id="artista-titulo" class="t-seccion">
							Sobre la artista
						</h2>
						<span class="filete filete--largo" aria-hidden="true" />
					</div>
					{bio && <p class="t-texto artista__bio">{bio}</p>}
					<a class="btn btn-contorno artista__boton" href={rutas.sobreMi}>
						Conocer más
						<Flecha />
					</a>
				</div>
			</div>
		</section>
	)
}

<style>
	.artista {
		position: relative;
		display: grid;
		margin-top: var(--bloque);
		overflow: hidden;
	}

	.artista__foto {
		position: relative;
		aspect-ratio: 4 / 3;
		-webkit-mask-image: var(--mascara-abajo);
		mask-image: var(--mascara-abajo);
		-webkit-mask-size: 100% 100%;
		mask-size: 100% 100%;
	}

	.artista__foto :global(.lqip) {
		position: absolute;
		inset: 0;
		background-color: transparent;
	}

	.artista__texto {
		padding-block: 0.5rem 2.75rem;
	}

	.artista__bio {
		max-width: 36rem;
		margin-top: 1.25rem;
	}

	.artista__boton {
		margin-top: 1.75rem;
	}

	/* Escritorio: la foto en el 46 % izquierdo, a sangre, fundida hacia la derecha. */
	@media (min-width: 64rem) {
		.artista {
			min-height: 24rem;
		}

		.artista__foto {
			position: absolute;
			inset: 0 auto 0 0;
			width: 50%;
			aspect-ratio: auto;
			-webkit-mask-image: var(--mascara-derecha);
			mask-image: var(--mascara-derecha);
		}

		.artista__texto {
			position: relative;
			display: grid;
			grid-template-columns: 46fr 54fr;
			align-items: center;
			padding-block: 3.5rem;
		}

		.artista__columna {
			grid-column: 2;
			padding-left: clamp(1rem, 3vw, 3rem);
		}

		.artista--sin-foto .artista__texto {
			grid-template-columns: 1fr;
		}

		.artista--sin-foto .artista__columna {
			grid-column: 1;
			padding-left: 0;
		}
	}
</style>
