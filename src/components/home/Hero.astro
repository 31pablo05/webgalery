---
import HeroCarrusel from './HeroCarrusel.jsx'
import { medidasImagen, urlFor } from '../../lib/sanity.js'
import { esExterno } from '../../lib/rutas.js'

// diapositivas: salida de fetchDiapositivasHero(). La imagen ocupa unos 2/3 a la derecha y se funde
// con el azul por una máscara de borde irregular; en móvil va arriba y se funde hacia abajo.
const { diapositivas = [], autoplay = false } = Astro.props

const ANCHOS = [800, 1200, 1800]

function fuenteHero(imagen) {
	const { ancho, alto } = medidasImagen(imagen)
	// Nunca se pide ni se declara una versión más ancha que la imagen real.
	const anchos = [...new Set(ANCHOS.map((valor) => Math.min(valor, ancho)))]
	const lista = anchos.map((valor) => ({ valor, url: urlFor(imagen).width(valor).url() }))
	const { x = 0.5, y = 0.5 } = imagen.hotspot || {}
	const posicion = `${(x * 100).toFixed(1)}% ${(y * 100).toFixed(1)}%`
	// Por debajo de 1200 px de ancho, cubrir el hero la estira y la foto se ve blanda.
	const contenida = ancho > 0 && ancho < 1200
	return {
		src: lista[lista.length - 1].url,
		srcset: lista.map(({ valor, url }) => `${url} ${valor}w`).join(', '),
		alt: imagen.alt || '',
		ancho,
		alto,
		posicion,
		posicionMovil: posicion,
		contenida,
	}
}

const preparadas = diapositivas.map((diapositiva) => ({
	id: diapositiva.id,
	etiqueta: diapositiva.etiqueta,
	titulo: diapositiva.titulo,
	subtitulo: diapositiva.subtitulo,
	textoBoton: diapositiva.textoBoton,
	enlace: diapositiva.enlace,
	externo: esExterno(diapositiva.enlace),
	imagen: fuenteHero(diapositiva.imagen),
}))
---

{
	preparadas.length > 0 && (
		<section class="hero ctx-azul textura" aria-label="Presentación">
			<HeroCarrusel client:load diapositivas={preparadas} autoplay={autoplay} />
		</section>
	)
}

<style is:global>
	/*
		Hero: primera pantalla, entre 560 y 760 px de alto en escritorio. Fondo azul con textura en los
		bordes; el lado del texto es azul profundo (el dorado chico necesita ese fondo para el contraste).
	*/
	.hero {
		background-color: var(--azul-oceano);
		overflow: hidden;
	}

	.hero.textura::before {
		-webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 18%, transparent 80%, #000 100%);
		mask-image: linear-gradient(180deg, #000 0%, transparent 18%, transparent 80%, #000 100%);
	}

	.hero__carrusel {
		position: relative;
		min-height: 100svh;
	}

	.hero__carrusel:focus-visible {
		outline: 1px solid var(--dorado);
		outline-offset: -4px;
	}

	.hero__pista {
		position: relative;
		min-height: 100svh;
	}

	.hero__diapositiva {
		position: absolute;
		inset: 0;
		display: grid;
		grid-template-rows: minmax(12rem, 46%) auto;
		align-content: start;
		padding-top: 6rem;
		opacity: 0;
		transition: opacity 0.6s var(--ease);
	}

	.hero__diapositiva.is-activa {
		position: relative;
		inset: auto;
		z-index: 1;
		min-height: 100svh;
		opacity: 1;
	}

	/* Móvil: la imagen arriba, fundida hacia abajo con la máscara irregular. */
	/* Arriba también se funde (suave) para que el encabezado se lea sobre el azul, no sobre la foto. */
	.hero__figura {
		position: relative;
		margin: 0;
		overflow: hidden;
		-webkit-mask-image: linear-gradient(180deg, transparent 0, rgb(0 0 0 / 0.35) 3.5rem, #000 9rem), var(--mascara-abajo);
		mask-image: linear-gradient(180deg, transparent 0, rgb(0 0 0 / 0.35) 3.5rem, #000 9rem), var(--mascara-abajo);
		-webkit-mask-size: 100% 100%;
		mask-size: 100% 100%;
		-webkit-mask-composite: source-in;
		mask-composite: intersect;
	}

	.hero__figura img,
	.hero__pendiente {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--posicion-movil, 50% 50%);
	}

	.hero__diapositiva:has(.hero__figura--contenida) {
		grid-template-rows: auto auto;
		row-gap: 0.5rem;
	}

	/* Foto horizontal de poca resolución: se muestra entera, nunca más grande que su archivo. */
	.hero__figura--contenida {
		display: flex;
		align-items: flex-end;
		justify-content: center;
		height: auto;
		padding: 0 1.25rem;
		-webkit-mask-image: none;
		mask-image: none;
	}

	.hero__figura--contenida img,
	.hero__figura--contenida .hero__pendiente {
		position: relative;
		inset: auto;
		width: min(100%, var(--ancho-nativo, 100%));
		height: auto;
		min-width: 0;
		min-height: 0;
		max-height: min(38vh, 16rem);
		object-fit: contain;
	}

	.hero__texto {
		position: relative;
		display: flex;
		align-items: flex-start;
		padding-top: 1.75rem;
		padding-bottom: 2.5rem;
	}

	.hero__bloque {
		display: grid;
		justify-items: start;
		gap: 0;
		max-width: 34rem;
		margin-top: 0;
	}

	.hero__etiqueta {
		margin-bottom: 0.9rem;
	}

	.hero__titulo {
		color: var(--blanco-calido);
		font-size: clamp(2.25rem, 9.5vw, 3rem);
	}

	.hero__filete {
		margin-top: 1.1rem;
	}

	.hero__subtitulo {
		max-width: 28rem;
		margin-top: 1.1rem;
		color: var(--azul-bruma);
		font-family: var(--font-body);
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.55;
		letter-spacing: 0;
		text-wrap: balance;
	}

	.hero__boton {
		margin-top: 1.5rem;
	}

	/* Flechas laterales finas (solo escritorio) y puntos abajo al centro, con área táctil de 44 px. */
	.hero__flecha {
		position: absolute;
		top: 50%;
		z-index: 2;
		display: none;
		place-items: center;
		width: 2.75rem;
		height: 4rem;
		padding: 0;
		border: 0;
		background: none;
		color: var(--blanco-calido);
		cursor: pointer;
		translate: 0 -50%;
		opacity: 0.85;
		transition: opacity 0.3s var(--ease);
	}

	/* Sombra muy suave: la flecha derecha cae sobre la foto, que puede ser clara. */
	.hero__flecha svg {
		width: 0.875rem;
		height: 1.75rem;
		filter: drop-shadow(0 1px 1px rgb(18 57 79 / 0.45));
	}

	.hero__flecha:hover {
		opacity: 1;
	}

	.hero__flecha--anterior {
		left: 0.75rem;
	}

	.hero__flecha--siguiente {
		right: 0.75rem;
	}

	.hero__puntos {
		position: absolute;
		left: 50%;
		bottom: 0.5rem;
		z-index: 2;
		display: flex;
		translate: -50% 0;
	}

	.hero__punto {
		position: relative;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
	}

	.hero__punto::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		width: 0.625rem;
		height: 0.625rem;
		border: 1px solid var(--blanco-calido);
		border-radius: 50%;
		translate: -50% -50%;
		transition:
			background-color 0.3s var(--ease),
			border-color 0.3s var(--ease);
	}

	.hero__punto[aria-current='true']::after {
		border-color: var(--dorado);
		background-color: var(--dorado);
	}

	.hero__flecha:focus-visible,
	.hero__punto:focus-visible {
		outline: 1px solid var(--dorado);
		outline-offset: -6px;
	}

	@media (min-width: 48rem) {
		.hero__diapositiva {
			grid-template-rows: minmax(14rem, 42%) auto;
		}

		.hero__figura--contenida img,
		.hero__figura--contenida .hero__pendiente {
			max-height: min(40vh, 20rem);
		}

		.hero__titulo {
			font-size: clamp(3rem, 5.5vw, 4rem);
		}
	}

	/* Escritorio: la imagen vive a la derecha. Si alcanza resolución, se funde con el azul. */
	@media (min-width: 64rem) {
		.hero__carrusel,
		.hero__pista,
		.hero__diapositiva.is-activa {
			height: 100svh;
			min-height: 100svh;
		}

		.hero__diapositiva {
			display: block;
			padding-top: 0;
		}

		.hero__figura {
			position: absolute;
			top: 0;
			right: 0;
			bottom: 0;
			left: 34%;
			-webkit-mask-image: var(--mascara-hero);
			mask-image: var(--mascara-hero);
			-webkit-mask-composite: source-over;
			mask-composite: add;
		}

		.hero__figura--contenida {
			top: 14%;
			right: max(var(--gutter), 3vw);
			bottom: 14%;
			left: auto;
			display: flex;
			align-items: center;
			justify-content: flex-end;
			width: min(46vw, var(--ancho-nativo, 46vw));
			padding: 0;
			-webkit-mask-image: none;
			mask-image: none;
		}

		.hero__figura--contenida img,
		.hero__figura--contenida .hero__pendiente {
			max-height: 100%;
		}

		.hero__figura img {
			object-position: var(--posicion, 50% 50%);
		}

		.hero__texto {
			height: 100%;
			align-items: center;
			padding-top: 6.5rem;
			padding-bottom: 3rem;
			padding-inline: calc(var(--gutter) + 1.5rem);
			pointer-events: none;
		}

		.hero__bloque {
			max-width: min(28rem, 38vw);
			margin-top: 0;
			pointer-events: auto;
		}

		.hero__titulo {
			font-size: clamp(3.25rem, 4.2vw, 5.25rem);
		}

		.hero__filete {
			margin-top: 1.5rem;
		}

		.hero__subtitulo {
			margin-top: 1.35rem;
		}

		.hero__boton {
			margin-top: 2.25rem;
		}

		.hero__flecha {
			display: grid;
		}

		.hero__puntos {
			bottom: 1.25rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__diapositiva,
		.hero__flecha,
		.hero__punto::after {
			transition: none;
		}
	}
</style>
