---
import Imagen from './Imagen.astro'
import { TRAZO_HERO, TRAZO_VERTICAL } from '../../lib/trazos.js'

const { hero, nombre = '', subtitulo = '', frase = '' } = Astro.props

// Las tres líneas de Sanity se muestran como un índice breve de prácticas.
const lineas = [hero?.linea1, hero?.linea2, hero?.linea3]
	.map((linea) => (linea || '').replace(/\s*\/\s*$/, '').trim())
	.filter(Boolean)
const tieneImagen = Boolean(hero?.imagen?.asset)

// El nombre va en dos renglones: nombre de pila arriba, apellidos abajo.
const [primero = '', ...resto] = String(nombre).trim().split(/\s+/)
const titulo = primero ? [primero, resto.join(' ')].filter(Boolean) : [lineas[0] || 'Inicio']
const [renglonUno, ...otrosRenglones] = titulo
---

<section class:list={['portada', !tieneImagen && 'portada--sin-imagen']} aria-label="Presentación">
	{
		tieneImagen && (
			<figure class="portada__figura">
				<Imagen
					source={hero.imagen}
					alt={hero.imagen.alt || ''}
					width={1200}
					height={1500}
					sizes="(min-width: 64rem) 42vw, 100vw"
					priority={true}
				/>
			</figure>
		)
	}

	{
		tieneImagen && (
			<svg class="trazo trazo--vertical" viewBox={TRAZO_VERTICAL.viewBox} aria-hidden="true" focusable="false">
				<path d={TRAZO_VERTICAL.d} pathLength="1" />
				<circle class="trazo__punto" {...TRAZO_VERTICAL.punto} />
			</svg>
		)
	}

	<div class="portada__cabeza">
		{subtitulo && <p class="portada__rol label">{subtitulo}</p>}
		<h1 class="portada__nombre">
			<span class="portada__linea">{renglonUno}</span>
			{otrosRenglones.map((parte) => (
				<>
					{' '}
					<span class="portada__linea">{parte}</span>
				</>
			))}
		</h1>
		{frase && <p class="portada__frase titulo-obra">{frase}</p>}
	</div>

	{
		tieneImagen && (
			<div class="portada__recorrido" aria-hidden="true">
				<svg class="trazo trazo--hero" viewBox={TRAZO_HERO.viewBox} preserveAspectRatio="none" focusable="false">
					<path d={TRAZO_HERO.d} pathLength="1" />
				</svg>
				<span
					class="portada__punto"
					style={`left: ${TRAZO_HERO.punto.x * 100}%; top: ${TRAZO_HERO.punto.y * 100}%`}
				/>
			</div>
		)
	}

	<div class="portada__pie">
		{lineas.length > 0 && (
			<ul class="portada__practicas">
				{lineas.map((linea) => (
					<li>{linea}</li>
				))}
			</ul>
		)}
		{hero?.bajada && <p class="portada__bajada">{hero.bajada}</p>}
		<a class="enlace portada__enlace" href="/obras">
			Ver obras <span class="arrow" aria-hidden="true">→</span>
		</a>
	</div>
</section>

<style>
	/* Móvil y tablet: la sección ocupa la primera pantalla; la foto se queda con el espacio que sobra. */
	.portada {
		display: flex;
		flex-direction: column;
		height: max(calc(100svh - 4rem), 34rem);
		padding: 0.75rem var(--gutter) 1.5rem;
	}

	.portada__figura {
		flex: 1 1 auto;
		min-height: 9rem;
		margin: 0 calc(-1 * var(--gutter));
		overflow: hidden;
		background-color: var(--color-surface);
	}

	.trazo--vertical {
		flex: none;
		width: 1.25rem;
		height: 3.75rem;
		margin: 0.25rem 0 0.35rem;
		overflow: visible;
	}

	.trazo path {
		fill: none;
		stroke: var(--color-ink);
		stroke-width: 1.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.trazo--vertical path {
		stroke-width: 2.6;
	}

	.trazo__punto {
		fill: var(--color-ink);
	}

	.portada__cabeza {
		flex: none;
	}

	.portada__nombre {
		margin-top: 0.5rem;
		font-family: var(--font-display);
		font-size: clamp(2.75rem, min(13.5vw, 8svh), 6rem);
		font-weight: 400;
		line-height: 0.92;
		letter-spacing: -0.045em;
	}

	.portada__linea {
		display: block;
		padding-bottom: 0.04em;
	}

	.portada__recorrido {
		display: none;
	}

	.portada__frase {
		margin-top: 0.6rem;
		font-size: clamp(1.5rem, 6.4vw, 2.25rem);
		line-height: 1.1;
	}

	.portada__pie {
		flex: none;
		display: grid;
		gap: 0.9rem;
		justify-items: start;
		padding-top: 1rem;
	}

	.portada__practicas {
		display: flex;
		flex-wrap: wrap;
		margin: 0;
		padding: 0;
		list-style: none;
		color: var(--color-muted);
		font-size: 0.9375rem;
	}

	.portada__practicas li + li::before {
		content: '/';
		padding: 0 0.5rem;
		color: var(--color-line);
	}

	.portada__bajada {
		max-width: 24rem;
		font-size: 1rem;
		line-height: 1.5;
	}

	.portada--sin-imagen {
		justify-content: center;
	}

	/*
		Escritorio: la foto ocupa la columna derecha y su borde superior coincide con la etiqueta.
		El nombre y la frase arriba; bajada y enlace abajo, a la altura del pie de la foto.
	*/
	@media (min-width: 64rem) {
		.portada {
			display: grid;
			grid-template-columns: repeat(12, minmax(0, 1fr));
			grid-template-rows: auto minmax(0, 1fr) auto;
			column-gap: 1.5rem;
			height: max(calc(100svh - 4.5rem), 34rem);
			padding: clamp(1.25rem, 4svh, 2.75rem) var(--gutter) clamp(1.5rem, 5svh, 3rem);
		}

		.portada__figura {
			grid-column: 8 / -1;
			grid-row: 1 / -1;
			margin: 0 calc(-1 * var(--gutter)) 0 0;
			min-height: 0;
		}

		.trazo--vertical {
			display: none;
		}

		.portada__cabeza {
			grid-column: 1 / 8;
			grid-row: 1;
			position: relative;
			z-index: 1;
		}

		.portada__nombre {
			margin-top: 0.9rem;
			font-size: clamp(4rem, min(8.4vw, 15.5svh), 9.75rem);
		}

		/* El espacio libre entre el nombre y la bajada es donde se dibuja la línea: nace en la foto y termina en el punto. */
		.portada__recorrido {
			position: relative;
			display: block;
			grid-column: 1 / 8;
			grid-row: 2;
			min-height: 5rem;
			margin: clamp(1rem, 3svh, 2rem) calc(-1.5rem - 1px) clamp(0.5rem, 2svh, 1.5rem) 0;
		}

		.trazo--hero {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			overflow: visible;
		}

		.trazo--hero path {
			stroke-width: 1.15;
		}

		.portada__punto {
			position: absolute;
			width: 0.4375rem;
			height: 0.4375rem;
			border-radius: 50%;
			background-color: var(--color-ink);
			translate: -50% -50%;
		}

		.portada__frase {
			margin-top: 1.1rem;
			font-size: clamp(1.75rem, min(2.6vw, 5svh), 2.75rem);
		}

		.portada__pie {
			grid-column: 1 / 7;
			grid-row: 3;
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: end;
			column-gap: 2rem;
			padding-top: 1.5rem;
		}

		.portada__practicas,
		.portada__bajada {
			grid-column: 1;
		}

		.portada__enlace {
			grid-column: 2;
			grid-row: 1 / span 2;
			align-self: end;
		}

		.portada--sin-imagen .portada__cabeza,
		.portada--sin-imagen .portada__pie {
			grid-column: 1 / -1;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.portada__linea,
		.portada__frase {
			animation: subir 1.1s var(--ease) both;
		}

		.portada__linea + .portada__linea {
			animation-delay: 0.12s;
		}

		.portada__frase {
			animation-delay: 0.24s;
		}

		.portada__rol,
		.portada__pie {
			animation: aparecer 1s var(--ease) 0.35s both;
		}

		.portada__figura :global(img) {
			animation: aparecer 1.4s var(--ease) both;
		}

		/* La línea se dibuja una vez, desde la imagen hasta el punto. */
		.trazo path {
			stroke-dasharray: 1;
			stroke-dashoffset: 1;
			animation: dibujar 1.8s cubic-bezier(0.55, 0.1, 0.3, 1) 0.6s forwards;
		}

		.portada__punto,
		.trazo__punto {
			animation: punto 0.5s var(--ease) 2.3s both;
			transform-box: fill-box;
			transform-origin: center;
		}
	}

	@keyframes subir {
		from {
			opacity: 0;
			transform: translateY(0.3em);
		}
	}

	@keyframes aparecer {
		from {
			opacity: 0;
		}
	}

	@keyframes dibujar {
		to {
			stroke-dashoffset: 0;
		}
	}

	@keyframes punto {
		from {
			opacity: 0;
			transform: scale(0.2);
		}
	}
</style>
