---
import Imagen from './Imagen.astro'

const { hero, nombre = '', subtitulo = '' } = Astro.props

// Las tres líneas de Sanity se muestran como un índice breve de prácticas.
const lineas = [hero?.linea1, hero?.linea2, hero?.linea3]
	.map((linea) => (linea || '').replace(/\s*\/\s*$/, '').trim())
	.filter(Boolean)
const tieneImagen = Boolean(hero?.imagen?.asset)

// El nombre va en dos renglones: nombre de pila arriba, apellidos abajo.
const [primero = '', ...resto] = String(nombre).trim().split(/\s+/)
const titulo = primero ? [primero, resto.join(' ')].filter(Boolean) : [lineas[0] || 'Inicio']
---

<section class:list={['portada', !tieneImagen && 'portada--sin-imagen']} aria-label="Presentación">
	{subtitulo && <p class="portada__rol">{subtitulo}</p>}

	<h1 class="portada__nombre">
		{titulo.map((parte, indice) => (
			<span class="portada__linea" style={`--i: ${indice}`}>
				{parte}
			</span>
		))}
	</h1>

	{
		tieneImagen && (
			<figure class="portada__figura">
				<Imagen
					source={hero.imagen}
					alt={hero.imagen.alt || ''}
					width={1200}
					height={1600}
					sizes="(min-width: 64rem) 42vw, 100vw"
					priority={true}
				/>
			</figure>
		)
	}

	<div class="portada__texto">
		{lineas.length > 0 && (
			<ul class="portada__practicas">
				{lineas.map((linea) => (
					<li>{linea}</li>
				))}
			</ul>
		)}
		{hero?.bajada && <p class="portada__bajada">{hero.bajada}</p>}
		<a class="enlace portada__enlace" href="/obras">
			Ver obras <span class="arrow" aria-hidden="true">→</span>
		</a>
	</div>
</section>

<style>
	.portada {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		padding: clamp(2.25rem, 8vw, 3.5rem) var(--gutter) 0;
	}

	.portada__rol {
		color: var(--color-muted);
		font-size: 0.9375rem;
	}

	.portada__nombre {
		margin-top: 0.75rem;
		font-family: var(--font-display);
		font-size: clamp(3rem, 14.2vw, 6rem);
		font-weight: 400;
		line-height: 0.9;
		letter-spacing: -0.045em;
	}

	.portada__linea {
		display: block;
		padding-bottom: 0.06em;
	}

	.portada__figura {
		margin: 2rem calc(-1 * var(--gutter)) 0;
		overflow: hidden;
		aspect-ratio: 4 / 5;
		max-height: 72svh;
		background-color: var(--color-surface);
	}

	.portada__texto {
		display: grid;
		gap: 1.25rem;
		justify-items: start;
		padding-top: 1.75rem;
	}

	.portada__practicas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0;
		margin: 0;
		padding: 0;
		list-style: none;
		color: var(--color-muted);
		font-size: 0.9375rem;
	}

	.portada__practicas li + li::before {
		content: '/';
		padding: 0 0.5rem;
		color: var(--color-line);
	}

	.portada__bajada {
		max-width: 30rem;
		font-size: 1.0625rem;
		line-height: 1.55;
	}

	.portada__enlace {
		margin-top: 0.5rem;
	}

	@media (min-width: 48rem) {
		.portada__figura {
			margin-inline: 0;
			aspect-ratio: 3 / 4;
			max-height: 80svh;
		}
	}

	/* Escritorio: texto abajo a la izquierda, fotografía alta que sangra hacia el borde derecho. */
	@media (min-width: 64rem) {
		.portada {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			grid-template-rows: minmax(0, 1fr) auto auto auto;
			column-gap: 1.5rem;
			min-height: calc(100svh - 4.5rem);
			padding-top: 2.5rem;
		}

		.portada__rol {
			grid-column: 1 / 8;
			grid-row: 2;
		}

		.portada__nombre {
			grid-column: 1 / 8;
			grid-row: 3;
			margin-top: 1rem;
			font-size: clamp(4.5rem, 8.4vw, 9.75rem);
		}

		.portada__texto {
			grid-column: 1 / 7;
			grid-row: 4;
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: end;
			column-gap: 2rem;
			padding-top: 2.75rem;
		}

		.portada__practicas,
		.portada__bajada {
			grid-column: 1;
		}

		.portada__enlace {
			grid-column: 2;
			grid-row: 1 / span 2;
			align-self: end;
			margin-top: 0;
		}

		.portada__figura {
			grid-column: 8 / -1;
			grid-row: 1 / -1;
			align-self: start;
			margin: 0 calc(-1 * var(--gutter)) 0 0;
			aspect-ratio: 3 / 4;
			max-height: calc(100svh - 4.5rem);
		}

		.portada--sin-imagen .portada__nombre,
		.portada--sin-imagen .portada__rol {
			grid-column: 1 / -1;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.portada__linea {
			animation: subir 1.1s var(--ease) both;
			animation-delay: calc(0.12s * var(--i));
		}

		.portada__rol,
		.portada__texto {
			animation: aparecer 1s var(--ease) 0.35s both;
		}

		.portada__figura :global(img) {
			animation: revelar 1.4s var(--ease) both;
		}
	}

	@keyframes subir {
		from {
			opacity: 0;
			transform: translateY(0.35em);
		}
	}

	@keyframes aparecer {
		from {
			opacity: 0;
		}
	}

	@keyframes revelar {
		from {
			opacity: 0;
			transform: scale(1.04);
		}
	}
</style>
