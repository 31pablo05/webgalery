---
import HeroCarrusel from './HeroCarrusel.jsx'
import { medidasImagen, urlFor } from '../../lib/sanity.js'
import { esExterno } from '../../lib/rutas.js'

// diapositivas: salida de fetchDiapositivasHero(). La imagen ocupa unos 2/3 a la derecha y se funde
// con el azul por una máscara de borde irregular; en móvil va arriba y se funde hacia abajo.
const { diapositivas = [], autoplay = false } = Astro.props

const ANCHOS = [800, 1200, 1800]

function fuenteHero(imagen) {
	const { ancho, alto } = medidasImagen(imagen)
	// Nunca se pide ni se declara una versión más ancha que la imagen real.
	const anchos = [...new Set(ANCHOS.map((valor) => Math.min(valor, ancho)))]
	const lista = anchos.map((valor) => ({ valor, url: urlFor(imagen).width(valor).url() }))
	const { x = 0.5, y = 0.5 } = imagen.hotspot || {}
	const posicion = `${(x * 100).toFixed(1)}% ${(y * 100).toFixed(1)}%`
	return {
		src: lista[lista.length - 1].url,
		srcset: lista.map(({ valor, url }) => `${url} ${valor}w`).join(', '),
		alt: imagen.alt || '',
		ancho,
		alto,
		posicion,
		posicionMovil: posicion,
	}
}

const preparadas = diapositivas.map((diapositiva) => ({
	id: diapositiva.id,
	etiqueta: diapositiva.etiqueta,
	titulo: diapositiva.titulo,
	subtitulo: diapositiva.subtitulo,
	textoBoton: diapositiva.textoBoton,
	enlace: diapositiva.enlace,
	externo: esExterno(diapositiva.enlace),
	imagen: fuenteHero(diapositiva.imagen),
}))
---

{
	preparadas.length > 0 && (
		<section class="hero ctx-azul textura" aria-label="Presentación">
			<HeroCarrusel client:load diapositivas={preparadas} autoplay={autoplay} />
		</section>
	)
}

<style is:global>
	/*
		Hero: primera pantalla, entre 560 y 760 px de alto en escritorio. Fondo azul con textura en los
		bordes; el lado del texto es azul profundo (el dorado chico necesita ese fondo para el contraste).
	*/
	.hero {
		--alto-hero: max(100svh, 40rem);
		background-image: linear-gradient(180deg, var(--azul-profundo) 0%, var(--azul-oceano) 55%, var(--azul-profundo) 100%);
		overflow: hidden;
	}

	.hero.textura::before {
		-webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 18%, transparent 80%, #000 100%);
		mask-image: linear-gradient(180deg, #000 0%, transparent 18%, transparent 80%, #000 100%);
	}

	.hero__carrusel {
		position: relative;
		height: var(--alto-hero);
	}

	.hero__carrusel:focus-visible {
		outline: 1px solid var(--dorado);
		outline-offset: -4px;
	}

	.hero__pista {
		position: relative;
		height: 100%;
	}

	.hero__diapositiva {
		position: absolute;
		inset: 0;
		display: grid;
		grid-template-rows: 57% 1fr;
		opacity: 0;
		transition: opacity 0.6s var(--ease);
	}

	.hero__diapositiva.is-activa {
		z-index: 1;
		opacity: 1;
	}

	/* Móvil: la imagen arriba, fundida hacia abajo con la máscara irregular. */
	/* Arriba también se funde (suave) para que el encabezado se lea sobre el azul, no sobre la foto. */
	.hero__figura {
		position: relative;
		margin: 0;
		overflow: hidden;
		-webkit-mask-image: linear-gradient(180deg, transparent 0, rgb(0 0 0 / 0.35) 3.5rem, #000 9rem), var(--mascara-abajo);
		mask-image: linear-gradient(180deg, transparent 0, rgb(0 0 0 / 0.35) 3.5rem, #000 9rem), var(--mascara-abajo);
		-webkit-mask-size: 100% 100%;
		mask-size: 100% 100%;
		-webkit-mask-composite: source-in;
		mask-composite: intersect;
	}

	.hero__figura img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--posicion-movil, 50% 50%);
	}

	.hero__texto {
		position: relative;
		display: flex;
		align-items: center;
		padding-bottom: 3.5rem;
	}

	.hero__bloque {
		display: grid;
		justify-items: start;
		gap: 0;
		max-width: 34rem;
		margin-top: 0;
	}

	.hero__etiqueta {
		margin-bottom: 0.9rem;
	}

	.hero__titulo {
		color: var(--blanco-calido);
		font-size: clamp(2.25rem, 9.5vw, 3rem);
	}

	.hero__filete {
		margin-top: 1.1rem;
	}

	.hero__subtitulo {
		max-width: 22rem;
		margin-top: 1.1rem;
		color: var(--azul-bruma);
		font-family: var(--font-ui);
		font-size: 0.8125rem;
		font-weight: 500;
		line-height: 1.75;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.hero__boton {
		margin-top: 1.5rem;
	}

	/* Flechas laterales finas (solo escritorio) y puntos abajo al centro, con área táctil de 44 px. */
	.hero__flecha {
		position: absolute;
		top: 50%;
		z-index: 2;
		display: none;
		place-items: center;
		width: 2.75rem;
		height: 4rem;
		padding: 0;
		border: 0;
		background: none;
		color: var(--blanco-calido);
		cursor: pointer;
		translate: 0 -50%;
		opacity: 0.85;
		transition: opacity 0.3s var(--ease);
	}

	/* Sombra muy suave: la flecha derecha cae sobre la foto, que puede ser clara. */
	.hero__flecha svg {
		width: 0.875rem;
		height: 1.75rem;
		filter: drop-shadow(0 0 3px rgb(18 57 79 / 0.9)) drop-shadow(0 0 10px rgb(18 57 79 / 0.6));
	}

	.hero__flecha:hover {
		opacity: 1;
	}

	.hero__flecha--anterior {
		left: 0.75rem;
	}

	.hero__flecha--siguiente {
		right: 0.75rem;
	}

	.hero__puntos {
		position: absolute;
		left: 50%;
		bottom: 0.5rem;
		z-index: 2;
		display: flex;
		translate: -50% 0;
	}

	.hero__punto {
		position: relative;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
	}

	.hero__punto::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		width: 0.625rem;
		height: 0.625rem;
		border: 1px solid var(--blanco-calido);
		border-radius: 50%;
		translate: -50% -50%;
		transition:
			background-color 0.3s var(--ease),
			border-color 0.3s var(--ease);
	}

	.hero__punto[aria-current='true']::after {
		border-color: var(--dorado);
		background-color: var(--dorado);
	}

	.hero__flecha:focus-visible,
	.hero__punto:focus-visible {
		outline: 1px solid var(--dorado);
		outline-offset: -6px;
	}

	@media (min-width: 48rem) {
		.hero__diapositiva {
			grid-template-rows: 58% 1fr;
		}

		.hero__titulo {
			font-size: clamp(3rem, 6.5vw, 4rem);
		}
	}

	/* Escritorio: imagen en los 2/3 de la derecha, fundida hacia la izquierda, arriba y abajo. */
	@media (min-width: 64rem) {
		.hero {
			--alto-hero: clamp(35rem, 100svh, 47.5rem);
		}

		.hero__diapositiva {
			display: block;
		}

		.hero__figura {
			position: absolute;
			top: 0;
			right: 0;
			bottom: 0;
			left: 30%;
			-webkit-mask-image: var(--mascara-hero);
			mask-image: var(--mascara-hero);
			-webkit-mask-composite: source-over;
			mask-composite: add;
		}

		.hero__figura img {
			object-position: var(--posicion, 50% 50%);
		}

		.hero__texto {
			height: 100%;
			align-items: center;
			padding-top: 5rem;
			padding-bottom: 3rem;
			padding-inline: calc(var(--gutter) + 2.5rem);
			pointer-events: none;
		}

		.hero__bloque {
			max-width: min(36%, 32rem);
			margin-top: 0;
			pointer-events: auto;
		}

		.hero__titulo {
			font-size: clamp(3.5rem, 4.6vw, 5rem);
		}

		.hero__filete {
			margin-top: 1.5rem;
		}

		.hero__subtitulo {
			margin-top: 1.5rem;
		}

		.hero__boton {
			margin-top: 2.25rem;
		}

		.hero__flecha {
			display: grid;
		}

		.hero__puntos {
			bottom: 1rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__diapositiva,
		.hero__flecha,
		.hero__punto::after {
			transition: none;
		}
	}
</style>
