---
import HeroCarrusel from './HeroCarrusel.jsx'
import Flecha from '../layout/Flecha.astro'
import { medidasImagen, urlFor } from '../../lib/sanity.js'
import { esExterno } from '../../lib/rutas.js'

/*
	Hero cinematográfico del Inicio.
	- Fondo: carrusel de fotos y videos a pantalla completa (HeroCarrusel.jsx).
	- Encima: capa azul profundo (más densa a la izquierda, donde va el texto) y la textura procedural, sutil.
	- Texto fijo, editable (artista.heroInicio): no cambia con las diapositivas.

	diapositivas: salida de fetchDiapositivasHero(). texto: salida de fetchHeroInicio().
*/
const { diapositivas = [], texto = {} } = Astro.props

const ANCHOS = [800, 1200, 1920]

function fuenteHero(imagen) {
	if (!imagen) return null
	const { ancho, alto } = medidasImagen(imagen)
	// Nunca se pide ni se declara una versión más ancha que la imagen real.
	const anchos = [...new Set(ANCHOS.map((valor) => Math.min(valor, ancho || valor)))]
	const lista = anchos.map((valor) => ({ valor, url: urlFor(imagen).width(valor).url() }))
	const { x = 0.5, y = 0.5 } = imagen.hotspot || {}
	return {
		src: lista[lista.length - 1].url,
		srcset: lista.map(({ valor, url }) => `${url} ${valor}w`).join(', '),
		alt: imagen.alt || '',
		ancho,
		alto,
		posicion: `${(x * 100).toFixed(1)}% ${(y * 100).toFixed(1)}%`,
	}
}

const preparadas = diapositivas.map((diapositiva) => ({
	id: diapositiva.id,
	tipo: diapositiva.tipo,
	video: diapositiva.video,
	epigrafe: diapositiva.epigrafe,
	imagen: fuenteHero(diapositiva.imagen),
}))

const { etiqueta = '', titulo = '', bajada = '', botonPrincipal = null, botonSecundario = null } = texto
const hayFondo = preparadas.length > 0
---

{
	(hayFondo || titulo) && (
		<section class:list={['hero', !hayFondo && 'hero--sin-fondo']} aria-labelledby="hero-titulo">
			{hayFondo && <HeroCarrusel client:load diapositivas={preparadas} />}
			<div class="hero__capa" aria-hidden="true" />
			<div class="hero__contenido contenedor">
				<div class="hero__bloque">
					{etiqueta && <p class="label hero__etiqueta">{etiqueta}</p>}
					{titulo && (
						<h1 id="hero-titulo" class="hero__titulo">
							{titulo}
						</h1>
					)}
					<span class="hero__filete" aria-hidden="true" />
					{bajada && <p class="hero__bajada">{bajada}</p>}
					{(botonPrincipal || botonSecundario) && (
						<div class="hero__botones">
							{botonPrincipal && (
								<a
									class="btn hero__btn hero__btn--relleno"
									href={botonPrincipal.enlace}
									target={esExterno(botonPrincipal.enlace) ? '_blank' : undefined}
									rel={esExterno(botonPrincipal.enlace) ? 'noopener noreferrer' : undefined}
								>
									{botonPrincipal.texto}
									<Flecha />
								</a>
							)}
							{botonSecundario && (
								<a
									class="btn hero__btn hero__btn--contorno"
									href={botonSecundario.enlace}
									target={esExterno(botonSecundario.enlace) ? '_blank' : undefined}
									rel={esExterno(botonSecundario.enlace) ? 'noopener noreferrer' : undefined}
								>
									{botonSecundario.texto}
								</a>
							)}
						</div>
					)}
				</div>
			</div>
		</section>
	)
}

<style is:global>
	/* ——— Contenedor ——— */
	.hero {
		position: relative;
		display: grid;
		min-height: max(36rem, 100svh);
		overflow: hidden;
		background-color: var(--azul-profundo);
		color: var(--blanco-calido);
	}

	.hero--sin-fondo {
		background-color: var(--azul-oceano);
	}

	/* ——— Fondo: fotos y videos (z 0) ——— */
	.hero__medios {
		position: absolute;
		inset: 0;
	}

	.hero__pista {
		position: absolute;
		inset: 0;
		overflow: hidden;
		z-index: 0;
	}

	.hero__fondo {
		position: absolute;
		inset: 0;
		opacity: 0;
		transition: opacity 0.9s var(--ease);
	}

	.hero__fondo.is-activa {
		opacity: 1;
	}

	.hero__fondo img,
	.hero__fondo video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--posicion, 50% 50%);
	}

	/* El video tapa a su póster recién cuando ya tiene imagen. */
	.hero__fondo video {
		background: transparent;
	}

	/* Acercamiento lentísimo, solo en las fotos y mientras están activas. */
	.hero__fondo--zoom img {
		transform: scale(1);
		transform-origin: var(--posicion, 50% 50%);
	}

	.hero__fondo--zoom.is-activa img {
		animation: hero-acercamiento 7.5s linear forwards;
	}

	@keyframes hero-acercamiento {
		to {
			transform: scale(1.045);
		}
	}

	/* ——— Capa azul + textura (z 1) ——— */
	.hero__capa {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background:
			linear-gradient(180deg, rgb(18 57 79 / 0.55) 0%, rgb(18 57 79 / 0) 22%),
			linear-gradient(0deg, rgb(18 57 79 / 0.7) 0%, rgb(18 57 79 / 0) 30%),
			linear-gradient(
				90deg,
				rgb(18 57 79 / 0.9) 0%,
				rgb(18 57 79 / 0.76) 28%,
				rgb(18 57 79 / 0.32) 56%,
				rgb(18 57 79 / 0.1) 100%
			);
	}

	/* La textura de pigmento y el grano de la identidad, muy suaves sobre la capa. */
	.hero__capa::before,
	.hero__capa::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.hero__capa::before {
		background-image: var(--textura-pigmento);
		background-size: 720px 720px;
		opacity: 0.16;
		mix-blend-mode: soft-light;
	}

	.hero__capa::after {
		background-image: var(--textura-grano);
		background-size: 220px 220px;
		opacity: 0.06;
		mix-blend-mode: overlay;
	}

	/* ——— Texto fijo (z 2) ——— */
	.hero__contenido {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		padding-block: 8rem 9rem;
		pointer-events: none;
	}

	.hero__bloque {
		max-width: 38rem;
		pointer-events: auto;
	}

	.hero__etiqueta {
		color: var(--dorado);
		letter-spacing: 0.22em;
	}

	.hero__titulo {
		margin: 1.1rem 0 0;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(3.25rem, 7.2vw, 6.75rem);
		line-height: 0.95;
		letter-spacing: -0.01em;
		color: var(--blanco-calido);
		text-wrap: balance;
		text-shadow: 0 1px 24px rgb(18 57 79 / 0.35);
	}

	.hero__filete {
		display: block;
		width: 3rem;
		height: 1px;
		margin-top: 1.75rem;
		background-color: var(--dorado);
	}

	.hero__bajada {
		max-width: 30rem;
		margin-top: 1.4rem;
		font-family: var(--font-body);
		font-size: clamp(1.0625rem, 1.35vw, 1.25rem);
		line-height: 1.55;
		color: color-mix(in srgb, var(--blanco-calido) 88%, transparent);
	}

	.hero__botones {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
		margin-top: 2.25rem;
	}

	.hero__btn {
		min-height: 3rem;
		padding-inline: 1.6rem;
	}

	.hero__btn--relleno {
		border-color: var(--blanco-calido);
		background-color: var(--blanco-calido);
		color: var(--azul-profundo);
	}

	.hero__btn--relleno:hover,
	.hero__btn--relleno:focus-visible {
		border-color: var(--marfil);
		background-color: var(--marfil);
	}

	.hero__btn--relleno:hover .flecha,
	.hero__btn--relleno:focus-visible .flecha {
		transform: translateX(4px);
	}

	.hero__btn--contorno {
		border-color: color-mix(in srgb, var(--blanco-calido) 70%, transparent);
		color: var(--blanco-calido);
	}

	.hero__btn--contorno:hover,
	.hero__btn--contorno:focus-visible {
		border-color: var(--dorado);
		background-color: rgb(18 57 79 / 0.35);
	}

	.hero__btn:focus-visible {
		outline: 1px solid var(--dorado);
		outline-offset: 3px;
	}

	/* ——— Controles (z 3) ——— */
	.hero__controles {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 3;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding-bottom: clamp(1.5rem, 4vh, 2.5rem);
	}

	.hero__controles:focus-visible {
		outline: none;
	}

	.hero__controles:focus-visible .hero__navegacion {
		outline: 1px solid var(--dorado);
		outline-offset: 6px;
	}

	.hero__epigrafe {
		min-height: 1.2em;
		margin: 0;
		font-family: var(--font-ui);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--azul-bruma);
	}

	.hero__epigrafe-texto {
		display: inline-block;
		animation: hero-epigrafe 0.9s var(--ease) both;
	}

	@keyframes hero-epigrafe {
		from {
			opacity: 0;
			transform: translateY(4px);
		}
	}

	.hero__navegacion {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.hero__indicadores {
		display: flex;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.hero__indicador {
		position: relative;
		display: block;
		width: 2.5rem;
		height: 1.5rem;
		padding: 0;
		border: 0;
		background: transparent;
		cursor: pointer;
	}

	/* Línea fina; la activa se rellena en dorado durante el tiempo que dura. */
	.hero__indicador::before,
	.hero__indicador-barra {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		top: 50%;
		height: 1px;
	}

	.hero__indicador::before {
		background-color: color-mix(in srgb, var(--blanco-calido) 38%, transparent);
	}

	.hero__indicador-barra {
		background-color: var(--dorado);
		transform: scaleX(0);
		transform-origin: left center;
	}

	.hero__indicador:hover::before {
		background-color: var(--blanco-calido);
	}

	.hero__indicador:focus-visible {
		outline: 1px solid var(--dorado);
		outline-offset: 2px;
	}

	.hero__flecha,
	.hero__pausa {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		border: 0;
		background: transparent;
		color: color-mix(in srgb, var(--blanco-calido) 75%, transparent);
		cursor: pointer;
		transition: color 0.3s var(--ease);
	}

	.hero__flecha svg {
		width: 0.5rem;
		height: 1rem;
	}

	.hero__pausa {
		margin-left: 0.25rem;
		border: 1px solid color-mix(in srgb, var(--blanco-calido) 35%, transparent);
		border-radius: 50%;
	}

	.hero__pausa svg {
		width: 0.625rem;
		height: 0.625rem;
	}

	.hero__flecha:hover,
	.hero__pausa:hover,
	.hero__flecha:focus-visible,
	.hero__pausa:focus-visible {
		color: var(--dorado);
	}

	.hero__flecha:focus-visible,
	.hero__pausa:focus-visible {
		outline: 1px solid var(--dorado);
		outline-offset: 2px;
	}

	/* ——— Móvil (ajuste fino en la etapa de mobile) ——— */
	@media (max-width: 47.99rem) {
		.hero__capa {
			background:
				linear-gradient(180deg, rgb(18 57 79 / 0.6) 0%, rgb(18 57 79 / 0) 25%),
				linear-gradient(0deg, rgb(18 57 79 / 0.94) 0%, rgb(18 57 79 / 0.78) 45%, rgb(18 57 79 / 0.25) 80%);
		}

		.hero__contenido {
			align-items: flex-end;
			padding-block: 7rem 6.5rem;
		}

		.hero__botones {
			flex-direction: column;
			align-items: stretch;
		}

		.hero__epigrafe {
			display: none;
		}

		.hero__controles {
			justify-content: center;
		}

		.hero__flecha {
			display: none;
		}

		.hero__indicador {
			width: 1.75rem;
			height: 2.75rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__fondo {
			transition: none;
		}

		.hero__fondo--zoom.is-activa img,
		.hero__epigrafe-texto {
			animation: none;
		}
	}
</style>
