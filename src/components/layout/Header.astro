---
const { nombre = '', subtitulo = '' } = Astro.props;

const nav = [
	{ href: '/', label: 'Inicio' },
	{ href: '/obras', label: 'Obras' },
	{ href: '/audiovisual', label: 'Audiovisual' },
	{ href: '/sobre-mi', label: 'Sobre mí' },
	{ href: '/contacto', label: 'Contacto' },
];

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

function isActive(href) {
	if (href === '/') return pathname === '/';
	return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="site-header" data-header>
	<div class="site-header__bar">
		<a class="brand" href="/">
			{nombre && <span class="brand__name">{nombre}</span>}
			{subtitulo && <span class="brand__role">{subtitulo}</span>}
		</a>

		<nav class="site-nav" aria-label="Principal">
			<ul class="site-nav__list">
				{
					nav.slice(1).map((item) => (
						<li>
							<a
								href={item.href}
								class:list={['site-nav__link', { 'is-active': isActive(item.href) }]}
								aria-current={isActive(item.href) ? 'page' : undefined}
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<button
			class="menu-toggle"
			type="button"
			data-menu-toggle
			aria-expanded="false"
			aria-controls="site-menu"
			aria-label="Abrir menú"
		>
			<span class="menu-toggle__icon" aria-hidden="true"></span>
		</button>
	</div>

	<div
		id="site-menu"
		class="menu-panel"
		data-menu-panel
		hidden
		role="dialog"
		aria-modal="true"
		aria-label="Menú"
	>
		<nav aria-label="Secciones">
			<ol class="menu-list">
				{
					nav.map((item, index) => (
						<li>
							<a
								href={item.href}
								class:list={['menu-link', { 'is-active': isActive(item.href) }]}
								aria-current={isActive(item.href) ? 'page' : undefined}
							>
								<span class="menu-link__num" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								{item.label}
							</a>
						</li>
					))
				}
			</ol>
		</nav>
	</div>
</header>

<script>
	const header = document.querySelector('[data-header]');

	if (header) {
		const toggle = header.querySelector('[data-menu-toggle]');
		const panel = header.querySelector('[data-menu-panel]');
		const desktop = window.matchMedia('(min-width: 64rem)');

		const setOpen = (open) => {
			if (!toggle || !panel) return;
			toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
			panel.hidden = !open;
			document.body.classList.toggle('menu-open', open);
		};

		toggle?.addEventListener('click', () => {
			setOpen(toggle.getAttribute('aria-expanded') !== 'true');
		});

		panel?.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setOpen(false);
		});

		desktop.addEventListener('change', (event) => {
			if (event.matches) setOpen(false);
		});

		// La línea inferior aparece solo cuando el contenido pasa por debajo del encabezado.
		const marcar = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
		marcar();
		window.addEventListener('scroll', marcar, { passive: true });
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
	}

	.site-header__bar {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		min-height: 4rem;
		padding: 0.75rem var(--gutter);
		border-bottom: 1px solid transparent;
		background-color: var(--color-bg);
		transition: border-color 0.4s var(--ease);
	}

	.site-header.is-scrolled .site-header__bar {
		border-bottom-color: var(--color-line);
	}

	.brand {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		column-gap: 0.75rem;
		min-width: 0;
		color: var(--color-ink);
		text-decoration: none;
	}

	.brand__name {
		font-family: var(--font-display);
		font-size: 1.0625rem;
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.01em;
	}

	.brand__role {
		display: none;
		color: var(--color-muted);
		font-size: 0.875rem;
		line-height: 1.2;
	}

	.site-nav {
		display: none;
	}

	.site-nav__list,
	.menu-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-nav__list {
		display: flex;
		align-items: center;
		gap: 2rem;
	}

	.site-nav__link {
		position: relative;
		color: var(--color-muted);
		font-size: 0.9375rem;
		font-weight: 400;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.3s var(--ease);
	}

	.site-nav__link::before {
		content: '';
		position: absolute;
		inset: -0.9rem -0.5rem;
	}

	.site-nav__link::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: -0.35rem;
		width: 100%;
		height: 1px;
		background-color: currentColor;
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform 0.45s var(--ease);
	}

	.site-nav__link:hover,
	.site-nav__link.is-active {
		color: var(--color-ink);
	}

	.site-nav__link.is-active::after {
		transform: scaleX(1);
	}

	.menu-toggle {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		margin-right: -0.6rem;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--color-ink);
		cursor: pointer;
	}

	.menu-toggle__icon {
		position: relative;
		display: block;
		width: 1.375rem;
		height: 0.5rem;
	}

	.menu-toggle__icon::before,
	.menu-toggle__icon::after {
		content: '';
		position: absolute;
		left: 0;
		width: 100%;
		height: 1px;
		background-color: currentColor;
		transition:
			transform 0.35s var(--ease),
			top 0.35s var(--ease),
			bottom 0.35s var(--ease);
	}

	.menu-toggle__icon::before {
		top: 0;
	}

	.menu-toggle__icon::after {
		bottom: 0;
	}

	.menu-toggle[aria-expanded='true'] .menu-toggle__icon::before,
	.menu-toggle[aria-expanded='true'] .menu-toggle__icon::after {
		top: 50%;
		bottom: auto;
	}

	.menu-toggle[aria-expanded='true'] .menu-toggle__icon::before {
		transform: translateY(-50%) rotate(45deg);
	}

	.menu-toggle[aria-expanded='true'] .menu-toggle__icon::after {
		transform: translateY(-50%) rotate(-45deg);
	}

	.menu-panel[hidden] {
		display: none;
	}

	.menu-panel:not([hidden]) {
		position: fixed;
		inset: 0;
		z-index: 1;
		display: flex;
		align-items: flex-end;
		padding: 6rem var(--gutter) 3rem;
		overflow-y: auto;
		background-color: var(--color-bg);
	}

	.menu-list {
		display: flex;
		flex-direction: column;
		width: 100%;
	}

	.menu-list li + li {
		border-top: 1px solid var(--color-line);
	}

	.menu-link {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		padding: 0.85rem 0;
		color: var(--color-ink);
		font-family: var(--font-display);
		font-size: clamp(2rem, 9vw, 3rem);
		font-weight: 400;
		line-height: 1.05;
		letter-spacing: -0.03em;
		text-decoration: none;
	}

	.menu-link__num {
		min-width: 1.5rem;
		color: var(--color-muted);
		font-family: var(--font-body);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.04em;
	}

	.menu-link.is-active {
		color: var(--color-muted);
	}

	.brand:focus-visible,
	.site-nav__link:focus-visible,
	.menu-link:focus-visible,
	.menu-toggle:focus-visible {
		outline: 1px solid var(--color-ink);
		outline-offset: 4px;
	}

	@media (min-width: 48rem) {
		.brand__role {
			display: inline;
		}
	}

	@media (min-width: 64rem) {
		.site-header__bar {
			min-height: 4.5rem;
		}

		.site-nav {
			display: block;
			min-width: 0;
		}

		.menu-toggle,
		.menu-panel,
		.menu-panel:not([hidden]) {
			display: none;
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.site-nav__link:hover::after {
			transform: scaleX(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header__bar,
		.site-nav__link,
		.site-nav__link::after,
		.menu-toggle__icon::before,
		.menu-toggle__icon::after {
			transition: none;
		}
	}

	:global(body.menu-open) {
		overflow: hidden;
	}
</style>
