---
// TODO: reemplazar estos valores con el documento "artista" de Sanity.
const { nombre = '', subtitulo = '' } = Astro.props;

const nav = [
	{ href: '/', label: 'Inicio' },
	{ href: '/obras', label: 'Obras' },
	{ href: '/audiovisual', label: 'Audiovisual' },
	{ href: '/sobre-mi', label: 'Sobre mí' },
	{ href: '/contacto', label: 'Contacto' },
];

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

function isActive(href) {
	if (href === '/') return pathname === '/';
	return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="site-header" data-header>
	<div class="site-header__bar">
		<a class="brand" href="/">
			{nombre && <span class="brand__name">{nombre}</span>}
			{subtitulo && <span class="brand__role">{subtitulo}</span>}
		</a>

		<nav class="site-nav" aria-label="Principal">
			<ul class="site-nav__list">
				{
					nav.map((item, index) => (
						<li class="site-nav__item">
							{index > 0 && (
								<span class="site-nav__dot" aria-hidden="true">
									·
								</span>
							)}
							<a
								href={item.href}
								class:list={['site-nav__link', { 'is-active': isActive(item.href) }]}
								aria-current={isActive(item.href) ? 'page' : undefined}
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<button
			class="menu-toggle"
			type="button"
			data-menu-toggle
			aria-expanded="false"
			aria-controls="site-menu"
			aria-label="Abrir menú"
		>
			<span class="menu-toggle__icon" aria-hidden="true"></span>
		</button>
	</div>

	<div
		id="site-menu"
		class="menu-panel"
		data-menu-panel
		hidden
		role="dialog"
		aria-modal="true"
		aria-label="Menú"
	>
		<nav aria-label="Secciones">
			<ul class="menu-list">
				{
					nav.map((item) => (
						<li>
							<a
								href={item.href}
								class:list={['menu-link', { 'is-active': isActive(item.href) }]}
								aria-current={isActive(item.href) ? 'page' : undefined}
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<script>
	const header = document.querySelector('[data-header]');

	if (header) {
		const toggle = header.querySelector('[data-menu-toggle]');
		const panel = header.querySelector('[data-menu-panel]');
		const desktop = window.matchMedia('(min-width: 64rem)');

		const setOpen = (open) => {
			if (!toggle || !panel) return;
			toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
			panel.hidden = !open;
			document.body.classList.toggle('menu-open', open);
		};

		toggle?.addEventListener('click', () => {
			setOpen(toggle.getAttribute('aria-expanded') !== 'true');
		});

		panel?.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setOpen(false);
		});

		desktop.addEventListener('change', (event) => {
			if (event.matches) setOpen(false);
		});
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		background-color: var(--color-bg);
	}

	.site-header__bar {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1.15rem 1.5rem;
		border-bottom: 1px solid var(--color-line);
		background-color: var(--color-bg);
	}

	.brand {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.4rem;
		min-width: 0;
		max-width: calc(100% - 3.25rem);
		color: var(--color-ink);
		text-decoration: none;
	}

	.brand__name,
	.brand__role {
		display: block;
		max-width: 100%;
		font-family: var(--font-display);
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: 0.35em;
		text-transform: uppercase;
		overflow-wrap: anywhere;
		margin-right: -0.35em;
	}

	.brand__name {
		font-size: 0.8125rem;
	}

	.brand__role {
		font-size: 0.625rem;
	}

	.site-nav {
		display: none;
	}

	.site-nav__list,
	.menu-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-nav__list {
		display: flex;
		align-items: center;
		gap: 0.95rem;
	}

	.site-nav__item {
		display: flex;
		align-items: center;
		gap: 0.95rem;
	}

	.site-nav__dot {
		color: var(--color-ink);
		font-family: var(--font-display);
		font-size: 0.75rem;
		line-height: 1;
	}

	.site-nav__link,
	.menu-link {
		position: relative;
		color: var(--color-ink);
		font-family: var(--font-display);
		font-weight: 400;
		letter-spacing: 0.18em;
		line-height: 1;
		text-decoration: none;
		text-transform: uppercase;
	}

	.site-nav__link {
		font-size: 0.75rem;
		white-space: nowrap;
	}

	.site-nav__link::before {
		content: '';
		position: absolute;
		inset: -0.85rem -0.2rem;
	}

	.site-nav__link::after,
	.menu-link::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: -0.45rem;
		width: 100%;
		height: 1px;
		background-color: var(--color-ink);
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform 0.45s ease;
	}

	.site-nav__link:hover::after,
	.site-nav__link.is-active::after,
	.menu-link:hover::after,
	.menu-link.is-active::after {
		transform: scaleX(1);
	}

	.menu-toggle {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		margin-right: -0.4rem;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--color-ink);
		cursor: pointer;
	}

	.menu-toggle__icon {
		position: relative;
		display: block;
		width: 1.375rem;
		height: 0.65rem;
	}

	.menu-toggle__icon::before,
	.menu-toggle__icon::after {
		content: '';
		position: absolute;
		left: 0;
		width: 100%;
		height: 1px;
		background-color: currentColor;
		transition:
			transform 0.35s ease,
			top 0.35s ease,
			bottom 0.35s ease;
	}

	.menu-toggle__icon::before {
		top: 0;
	}

	.menu-toggle__icon::after {
		bottom: 0;
	}

	.menu-toggle[aria-expanded='true'] .menu-toggle__icon::before,
	.menu-toggle[aria-expanded='true'] .menu-toggle__icon::after {
		top: 50%;
		bottom: auto;
	}

	.menu-toggle[aria-expanded='true'] .menu-toggle__icon::before {
		transform: translateY(-50%) rotate(40deg);
	}

	.menu-toggle[aria-expanded='true'] .menu-toggle__icon::after {
		transform: translateY(-50%) rotate(-40deg);
	}

	.menu-panel[hidden] {
		display: none;
	}

	.menu-panel:not([hidden]) {
		position: fixed;
		inset: 0;
		z-index: 1;
		display: flex;
		align-items: safe center;
		padding: 7rem 1.5rem 3rem;
		overflow-y: auto;
		background-color: var(--color-bg);
	}

	.menu-list {
		display: flex;
		flex-direction: column;
		gap: 1.6rem;
	}

	.menu-link {
		display: inline-block;
		max-width: 100%;
		font-size: clamp(2rem, 8vw, 3.25rem);
		font-weight: 300;
		letter-spacing: 0.12em;
		overflow-wrap: break-word;
	}

	.menu-link::before {
		content: '';
		position: absolute;
		inset: -0.4rem 0;
	}

	.brand:focus-visible,
	.site-nav__link:focus-visible,
	.menu-link:focus-visible,
	.menu-toggle:focus-visible {
		outline: 1px solid var(--color-ink);
		outline-offset: 4px;
	}

	@media (min-width: 64rem) {
		.site-header__bar {
			padding: 1.35rem 2.5rem;
		}

		.site-nav {
			display: block;
			min-width: 0;
		}

		.site-nav__list {
			flex-wrap: wrap;
			justify-content: flex-end;
		}

		.brand {
			max-width: none;
		}

		.menu-toggle,
		.menu-panel,
		.menu-panel:not([hidden]) {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-nav__link::after,
		.menu-link::after,
		.menu-toggle__icon::before,
		.menu-toggle__icon::after {
			transition: none;
		}
	}

	:global(body.menu-open) {
		overflow: hidden;
	}
</style>
