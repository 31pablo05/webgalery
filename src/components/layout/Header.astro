---
const { nombre = '', instagram = '', vimeo = '' } = Astro.props;

const nav = [
	{ href: '/obras', label: 'Obras' },
	{ href: '/audiovisual', label: 'Audiovisual' },
	{ href: '/sobre-mi', label: 'Sobre mí' },
	{ href: '/contacto', label: 'Contacto' },
];

const redes = [
	{ href: instagram, label: 'Instagram' },
	{ href: vimeo, label: 'Vimeo' },
].filter((item) => item.href);

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

function isActive(href) {
	return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="site-header" data-header>
	<div class="site-header__bar contenedor">
		<a class="brand" href="/">{nombre || 'Inicio'}</a>

		<nav class="site-nav" aria-label="Principal">
			<ul class="site-nav__list">
				{
					nav.map((item) => (
						<li>
							<a
								href={item.href}
								class:list={['site-nav__link', { 'is-active': isActive(item.href) }]}
								aria-current={isActive(item.href) ? 'page' : undefined}
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<button
			class="menu-toggle"
			type="button"
			data-menu-toggle
			aria-expanded="false"
			aria-controls="site-menu"
		>
			<span data-menu-texto>Menú</span>
		</button>
	</div>

	<div id="site-menu" class="menu-panel" data-menu-panel hidden role="dialog" aria-modal="true" aria-label="Menú">
		<nav class="menu-panel__nav contenedor" aria-label="Secciones">
			<ol class="menu-list">
				{
					[{ href: '/', label: 'Inicio' }, ...nav].map((item, index) => {
						const activo = item.href === '/' ? pathname === '/' : isActive(item.href);
						return (
							<li>
								<a
									href={item.href}
									class:list={['menu-link', { 'is-active': activo }]}
									aria-current={activo ? 'page' : undefined}
								>
									<span class="menu-link__num" aria-hidden="true">
										{String(index + 1).padStart(2, '0')}
									</span>
									<span class="menu-link__texto">{item.label}</span>
								</a>
							</li>
						);
					})
				}
			</ol>
			{
				redes.length > 0 && (
					<ul class="menu-redes">
						{redes.map((item) => (
							<li>
								<a class="enlace" href={item.href} target="_blank" rel="noopener noreferrer">
									{item.label} <span aria-hidden="true">↗</span>
									<span class="sr-only">(se abre en otra pestaña)</span>
								</a>
							</li>
						))}
					</ul>
				)
			}
		</nav>
	</div>
</header>

<script>
	const header = document.querySelector('[data-header]');

	if (header) {
		const toggle = header.querySelector('[data-menu-toggle]');
		const texto = header.querySelector('[data-menu-texto]');
		const panel = header.querySelector('[data-menu-panel]');
		const desktop = window.matchMedia('(min-width: 64rem)');

		const setOpen = (open) => {
			if (!toggle || !panel) return;
			toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			if (texto) texto.textContent = open ? 'Cerrar' : 'Menú';
			panel.hidden = !open;
			document.body.classList.toggle('menu-open', open);
			header.classList.toggle('is-open', open);
		};

		toggle?.addEventListener('click', () => {
			setOpen(toggle.getAttribute('aria-expanded') !== 'true');
		});

		panel?.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setOpen(false);
		});

		desktop.addEventListener('change', (event) => {
			if (event.matches) setOpen(false);
		});

		// Arriba de todo el encabezado es transparente; pasados los 80 px toma fondo y se achica.
		const marcar = () => header.classList.toggle('is-scrolled', window.scrollY > 80);
		marcar();
		window.addEventListener('scroll', marcar, { passive: true });
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
	}

	.site-header__bar {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		height: 4.5rem;
		transition: height 0.4s var(--ease);
	}

	/* La línea inferior y el fondo viven en un pseudo-elemento para que ocupen todo el ancho. */
	.site-header::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		border-bottom: 1px solid transparent;
		background-color: transparent;
		transition:
			background-color 0.4s var(--ease),
			border-color 0.4s var(--ease);
	}

	.site-header.is-scrolled::before {
		border-bottom-color: var(--color-line);
		background-color: color-mix(in srgb, var(--color-bg) 78%, transparent);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
	}

	.site-header.is-scrolled .site-header__bar {
		height: 3.75rem;
	}

	.site-header.is-open::before {
		background-color: var(--color-bg);
		border-bottom-color: transparent;
	}

	.brand {
		min-width: 0;
		color: var(--color-ink);
		font-family: var(--font-display);
		font-size: 1.125rem;
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.01em;
		text-decoration: none;
	}

	.site-nav {
		display: none;
	}

	.site-nav__list,
	.menu-list,
	.menu-redes {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-nav__list {
		display: flex;
		align-items: center;
		gap: 2.25rem;
	}

	.site-nav__link {
		position: relative;
		display: inline-flex;
		align-items: center;
		color: var(--color-ink);
		font-size: 0.9375rem;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
		transition: opacity 0.3s var(--ease);
	}

	.site-nav__link::before {
		content: '';
		position: absolute;
		inset: -0.9rem -0.5rem;
	}

	/* Sección activa: un punto chico antes del nombre. */
	.site-nav__link.is-active::after {
		content: '';
		position: absolute;
		top: 50%;
		left: -0.75rem;
		width: 0.3rem;
		height: 0.3rem;
		border-radius: 50%;
		background-color: currentColor;
		translate: 0 -50%;
	}

	.menu-toggle {
		position: relative;
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--color-ink);
		font-size: 0.9375rem;
		cursor: pointer;
	}

	.menu-toggle::before {
		content: '';
		position: absolute;
		inset: 0 -0.75rem;
	}

	.menu-panel[hidden] {
		display: none;
	}

	.menu-panel:not([hidden]) {
		position: fixed;
		inset: 0;
		z-index: 1;
		display: flex;
		padding: 6rem 0 2.5rem;
		overflow-y: auto;
		background-color: var(--color-bg);
	}

	.menu-panel__nav {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 3rem;
	}

	.menu-list li + li {
		border-top: 1px solid var(--color-line);
	}

	.menu-link {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		padding: 0.6rem 0;
		color: var(--color-ink);
		text-decoration: none;
	}

	.menu-link__num {
		min-width: 1.5rem;
		color: var(--color-muted);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.04em;
	}

	.menu-link__texto {
		font-family: var(--font-serif);
		font-size: clamp(2.5rem, 11vw, 3.5rem);
		font-style: italic;
		line-height: 1.1;
	}

	.menu-link.is-active .menu-link__texto {
		color: var(--color-muted);
	}

	.menu-redes {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
	}

	.brand:focus-visible,
	.site-nav__link:focus-visible,
	.menu-link:focus-visible,
	.menu-toggle:focus-visible {
		outline: 1px solid var(--color-ink);
		outline-offset: 4px;
	}

	@media (min-width: 64rem) {
		.site-header__bar {
			height: 5.5rem;
		}

		.site-header.is-scrolled .site-header__bar {
			height: 4.25rem;
		}

		.brand {
			font-size: 1.1875rem;
		}

		.site-nav {
			display: block;
		}

		.menu-toggle,
		.menu-panel,
		.menu-panel:not([hidden]) {
			display: none;
		}
	}

	/* En hover, el resto de los enlaces baja su opacidad y el señalado queda pleno. */
	@media (hover: hover) and (pointer: fine) {
		.site-nav__list:hover .site-nav__link {
			opacity: 0.45;
		}

		.site-nav__list:hover .site-nav__link:hover {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header__bar,
		.site-header::before,
		.site-nav__link {
			transition: none;
		}
	}

	:global(body.menu-open) {
		overflow: hidden;
	}
</style>
