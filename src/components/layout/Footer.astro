---
const {
	nombre = '',
	subtitulo = '',
	email = '',
	ciudad = '',
	instagram = '',
	vimeo = '',
	youtube = '',
} = Astro.props;

const redes = [
	{ href: instagram, label: 'Instagram' },
	{ href: vimeo, label: 'Vimeo' },
	{ href: youtube, label: 'YouTube' },
].filter((item) => item.href);

const secciones = [
	{ href: '/obras', label: 'Obras' },
	{ href: '/audiovisual', label: 'Audiovisual' },
	{ href: '/sobre-mi', label: 'Sobre mí' },
	{ href: '/contacto', label: 'Contacto' },
];

const anio = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<div class="site-footer__marca">
			{nombre && (
				<a class="site-footer__nombre" href="/">
					{nombre}
				</a>
			)}
			{subtitulo && <p class="site-footer__rol">{subtitulo}</p>}
		</div>

		<div class="site-footer__columnas">
			<nav class="site-footer__col" aria-label="Secciones del sitio">
				<p class="label">Secciones</p>
				<ul>
					{secciones.map((item) => (
						<li>
							<a class="site-footer__link" href={item.href}>
								{item.label}
							</a>
						</li>
					))}
				</ul>
			</nav>

			{
				redes.length > 0 && (
					<div class="site-footer__col">
						<p class="label">Redes</p>
						<ul>
							{redes.map((item) => (
								<li>
									<a class="site-footer__link" href={item.href} target="_blank" rel="noopener noreferrer">
										{item.label}
										<span class="site-footer__externo" aria-hidden="true">
											↗
										</span>
										<span class="sr-only"> (se abre en otra pestaña)</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				)
			}

			{
				(email || ciudad) && (
					<div class="site-footer__col">
						<p class="label">Contacto</p>
						<ul>
							{email && (
								<li>
									<a class="site-footer__link" href={`mailto:${email}`}>
										{email}
									</a>
								</li>
							)}
							{ciudad && <li class="site-footer__dato">{ciudad}</li>}
						</ul>
					</div>
				)
			}
		</div>
	</div>

	<div class="site-footer__base">
		<p>© {anio}{nombre && ` ${nombre}`}</p>
	</div>
</footer>

<style>
	.site-footer {
		padding: 4rem var(--gutter) 2rem;
		border-top: 1px solid var(--color-line);
		background-color: var(--color-bg);
		color: var(--color-ink);
	}

	.site-footer__inner {
		display: grid;
		gap: 3rem;
	}

	.site-footer__nombre {
		display: inline-block;
		color: inherit;
		font-family: var(--font-display);
		font-size: clamp(2.25rem, 6vw, 4.5rem);
		font-weight: 400;
		line-height: 0.95;
		letter-spacing: -0.035em;
		text-decoration: none;
	}

	.site-footer__rol {
		margin-top: 0.75rem;
		color: var(--color-muted);
		font-size: 0.9375rem;
	}

	.site-footer__columnas {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2.25rem 1.5rem;
	}

	.site-footer__col ul {
		display: grid;
		gap: 0.55rem;
		margin: 0.9rem 0 0;
		padding: 0;
		list-style: none;
	}

	.site-footer__link,
	.site-footer__dato {
		position: relative;
		display: inline-flex;
		align-items: baseline;
		gap: 0.35rem;
		color: var(--color-ink);
		font-size: 0.9375rem;
		line-height: 1.4;
		text-decoration: none;
		overflow-wrap: anywhere;
	}

	.site-footer__link::before {
		content: '';
		position: absolute;
		inset: -0.45rem -0.3rem;
	}

	.site-footer__link:hover {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.25em;
	}

	.site-footer__externo {
		color: var(--color-muted);
		font-size: 0.8em;
	}

	.site-footer__base {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 2rem;
		margin-top: 4rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--color-line);
		color: var(--color-muted);
		font-size: 0.8125rem;
	}

	.site-footer__nombre:focus-visible,
	.site-footer__link:focus-visible {
		outline: 1px solid var(--color-ink);
		outline-offset: 4px;
	}

	@media (min-width: 64rem) {
		.site-footer {
			padding-top: 5.5rem;
		}

		.site-footer__inner {
			grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
			align-items: start;
		}

		.site-footer__columnas {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.site-footer__base {
			margin-top: 6rem;
		}
	}
</style>
