---
import Trazo from './Trazo.astro';

const {
	nombre = '',
	subtitulo = '',
	email = '',
	ciudad = '',
	instagram = '',
	vimeo = '',
	youtube = '',
} = Astro.props;

const redes = [
	{ href: instagram, label: 'Instagram' },
	{ href: vimeo, label: 'Vimeo' },
	{ href: youtube, label: 'YouTube' },
].filter((item) => item.href);

const secciones = [
	{ href: '/obras', label: 'Obras' },
	{ href: '/audiovisual', label: 'Audiovisual' },
	{ href: '/sobre-mi', label: 'Sobre mí' },
	{ href: '/contacto', label: 'Contacto' },
];

const anio = new Date().getFullYear();
---

<footer class="site-footer">
	<Trazo />
	<div class="site-footer__inner contenedor grilla">
		<div class="site-footer__marca">
			{nombre && (
				<a class="site-footer__nombre" href="/">
					{nombre}
				</a>
			)}
			{subtitulo && <p class="site-footer__rol">{subtitulo}</p>}
		</div>

		<nav class="site-footer__fila" aria-label="Secciones del sitio">
			{secciones.map((item) => (
				<a class="site-footer__link" href={item.href}>
					{item.label}
				</a>
			))}
		</nav>

		{
			(redes.length > 0 || email || ciudad) && (
				<div class="site-footer__fila site-footer__fila--redes">
					{redes.map((item) => (
						<a class="site-footer__link" href={item.href} target="_blank" rel="noopener noreferrer">
							{item.label}
							<span class="site-footer__externo" aria-hidden="true">
								↗
							</span>
							<span class="sr-only"> (se abre en otra pestaña)</span>
						</a>
					))}
					{email && (
						<a class="site-footer__link" href={`mailto:${email}`}>
							{email}
						</a>
					)}
					{ciudad && <span class="site-footer__dato">{ciudad}</span>}
				</div>
			)
		}

		<p class="site-footer__copia">© {anio}{nombre && ` ${nombre}`}</p>
	</div>
</footer>

<style>
	.site-footer {
		padding-bottom: 2.5rem;
		color: var(--color-ink);
	}

	.site-footer__inner {
		row-gap: 1.75rem;
		align-items: baseline;
	}

	.site-footer__marca,
	.site-footer__fila,
	.site-footer__copia {
		grid-column: 1 / -1;
	}

	.site-footer__nombre {
		color: inherit;
		font-family: var(--font-display);
		font-size: 1.375rem;
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.015em;
		text-decoration: none;
	}

	.site-footer__fila {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.75rem;
	}

	.site-footer__link,
	.site-footer__dato {
		position: relative;
		display: inline-flex;
		align-items: baseline;
		gap: 0.3rem;
		color: var(--color-ink);
		font-size: 0.9375rem;
		line-height: 1.4;
		text-decoration: none;
		overflow-wrap: anywhere;
	}

	.site-footer__rol {
		margin-top: 0.25rem;
		font-size: 0.9375rem;
	}

	.site-footer__rol,
	.site-footer__dato,
	.site-footer__externo,
	.site-footer__copia {
		color: var(--color-muted);
	}

	.site-footer__link::before {
		content: '';
		position: absolute;
		inset: -0.6rem -0.4rem;
	}

	.site-footer__link:hover {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.25em;
	}

	.site-footer__copia {
		font-size: 0.8125rem;
	}

	.site-footer__nombre:focus-visible,
	.site-footer__link:focus-visible {
		outline: 1px solid var(--color-ink);
		outline-offset: 4px;
	}

	/* Escritorio: todo en una fila, alineado a la grilla. */
	@media (min-width: 64rem) {
		.site-footer__marca {
			grid-column: 1 / 4;
		}

		.site-footer__fila {
			grid-column: 4 / 9;
		}

		.site-footer__fila--redes {
			grid-column: 9 / 13;
			justify-content: flex-end;
		}

		.site-footer__copia {
			margin-top: 1rem;
		}
	}
</style>
