---
// TODO: reemplazar estos valores con el documento "configuracion" de Sanity.
const {
	nombre = '',
	subtitulo = '',
	email = '',
	ciudad = '',
	instagram = '',
	vimeo = '',
	youtube = '',
} = Astro.props;

const social = [
	{ href: instagram, label: 'Instagram', name: 'instagram' },
	{ href: vimeo, label: 'Vimeo', name: 'vimeo' },
	{ href: youtube, label: 'YouTube', name: 'youtube' },
].filter((item) => item.href);
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<a class="brand" href="/">
			{nombre && <span class="brand__name">{nombre}</span>}
			{subtitulo && <span class="brand__role">{subtitulo}</span>}
		</a>

		<div class="site-footer__meta">
			{
				email && (
					<a class="meta-row" href={`mailto:${email}`}>
						<svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
							<rect x="3.25" y="5.25" width="17.5" height="13.5" />
							<path d="M4 7.2 12 12.6 20 7.2" />
						</svg>
						<span>{email}</span>
					</a>
				)
			}
			{
				ciudad && (
					<p class="meta-row">
						<svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M12 21.2s6.25-5.3 6.25-10.05a6.25 6.25 0 1 0-12.5 0C5.75 15.9 12 21.2 12 21.2z" />
							<circle cx="12" cy="11" r="1.9" />
						</svg>
						<span>{ciudad}</span>
					</p>
				)
			}
		</div>

		{
			social.length > 0 && (
				<ul class="social">
					{social.map((item) => (
						<li>
							<a
								class="social__link"
								href={item.href}
								aria-label={item.label}
								target="_blank"
								rel="noopener noreferrer"
							>
								{item.name === 'instagram' && (
									<svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
										<rect x="3.75" y="3.75" width="16.5" height="16.5" />
										<circle cx="12" cy="12" r="3.75" />
										<rect class="icon__fill" x="16.6" y="6.1" width="1.4" height="1.4" />
									</svg>
								)}
								{item.name === 'vimeo' && (
									<svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
										<rect x="3.75" y="3.75" width="16.5" height="16.5" />
										<path d="M8 9.2 12 16l4-6.8" />
									</svg>
								)}
								{item.name === 'youtube' && (
									<svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
										<rect x="2.75" y="6.25" width="18.5" height="11.5" />
										<path d="M10.5 9.4v5.2L15.4 12l-4.9-2.6z" />
									</svg>
								)}
							</a>
						</li>
					))}
				</ul>
			)
		}
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-line);
		padding: 5.5rem 1.5rem;
		background-color: var(--color-bg);
		color: var(--color-ink);
	}

	.site-footer__inner {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 2.75rem;
	}

	.brand {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.4rem;
		max-width: 100%;
		color: inherit;
		text-decoration: none;
	}

	.brand__name,
	.brand__role {
		display: block;
		max-width: 100%;
		font-family: var(--font-display);
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: 0.35em;
		text-transform: uppercase;
		overflow-wrap: anywhere;
		margin-right: -0.35em;
	}

	.brand__name {
		font-size: 0.8125rem;
	}

	.brand__role {
		font-size: 0.625rem;
	}

	.site-footer__meta {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.9rem;
	}

	.meta-row {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		margin: 0;
		color: var(--color-ink);
		font-family: var(--font-body);
		font-size: 0.9375rem;
		font-weight: 400;
		line-height: 1.4;
		text-decoration: none;
		transition: color 0.3s ease;
	}

	a.meta-row {
		position: relative;
	}

	a.meta-row::before {
		content: '';
		position: absolute;
		inset: -0.7rem -0.25rem;
	}

	a.meta-row:hover {
		color: var(--color-muted);
	}

	.social {
		display: flex;
		align-items: center;
		gap: 1.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.social__link {
		position: relative;
		display: inline-flex;
		color: var(--color-ink);
		transition: color 0.3s ease;
	}

	.social__link::before {
		content: '';
		position: absolute;
		inset: -0.75rem;
	}

	.social__link:hover {
		color: var(--color-muted);
	}

	.icon {
		width: 1.25rem;
		height: 1.25rem;
		flex: 0 0 auto;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: square;
		stroke-linejoin: miter;
	}

	.icon__fill {
		fill: currentColor;
		stroke: none;
	}

	.brand:focus-visible,
	.meta-row:focus-visible,
	.social__link:focus-visible {
		outline: 1px solid var(--color-ink);
		outline-offset: 4px;
	}

	@media (min-width: 64rem) {
		.site-footer {
			padding: 7rem 2.5rem;
		}

		.site-footer__inner {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
			column-gap: 2rem;
		}

		.social {
			justify-self: end;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.meta-row,
		.social__link {
			transition: none;
		}
	}
</style>
