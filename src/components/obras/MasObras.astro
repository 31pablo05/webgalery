---
const { obras = [] } = Astro.props
---

{
	obras.length > 0 && (
		<section class="mas-obras fade-in">
			<div class="mas-obras__cabecera">
				<h2>Más obras</h2>
				<a class="link-arrow" href="/obras">
					Ver todas las obras <span class="arrow" aria-hidden="true">→</span>
				</a>
			</div>
			<ul class="mas-obras__lista">
				{obras.map((obra) => (
					<li>
						<a class="mas-obras__link" href={`/obras/${obra.slug}`}>
							<div class="mas-obras__marco">
								{obra.miniatura && (
									<img
										class="mas-obras__img"
										src={obra.miniatura.src}
										srcset={obra.miniatura.srcset}
										sizes="(min-width: 64rem) 22vw, 45vw"
										alt={obra.miniatura.alt || obra.titulo}
										width="900"
										height="900"
										loading="lazy"
										decoding="async"
									/>
								)}
							</div>
							<p class="mas-obras__titulo">{obra.titulo}</p>
						</a>
					</li>
				))}
			</ul>
		</section>
	)
}
