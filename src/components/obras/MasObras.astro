---
import Imagen from '../home/Imagen.astro'

// Tres obras en su proporción original, alineadas abajo; primero las del mismo proyecto.
const { obras = [] } = Astro.props
---

{
	obras.length > 0 && (
		<section class="mas-obras contenedor" aria-labelledby="mas-obras-titulo">
			<div class="mas-obras__cabecera grilla">
				<h2 id="mas-obras-titulo" class="titulo-seccion">
					Más obras
				</h2>
				<a class="enlace" href="/obras">
					Ver todas las obras <span class="arrow" aria-hidden="true">→</span>
				</a>
			</div>
			<ul class="mas-obras__lista grilla">
				{obras.map((obra, indice) => (
					<li class="mas-obras__item fade-in" style={`--movil: ${indice === 1 ? '3 / 5' : '1 / 3'}`}>
						<a class="mas-obras__link" href={`/obras/${obra.slug}`}>
							<Imagen
								source={obra.imagen}
								alt={obra.imagen?.alt || obra.titulo}
								width={700}
								sizes="(min-width: 64rem) min(31vw, 540px), 50vw"
								transicion={`obra-${obra.slug}`}
							/>
							<p class="mas-obras__titulo titulo-obra">{obra.titulo}</p>
							{(obra.proyecto || obra.anio) && (
								<p class="mas-obras__meta">{[obra.proyecto, obra.anio].filter(Boolean).join(' · ')}</p>
							)}
						</a>
					</li>
				))}
			</ul>
		</section>
	)
}
