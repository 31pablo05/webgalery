---
import { rutaSerie } from '../../lib/rutas.js'

const { obra, whatsapp = '', envio = '', anterior = null, siguiente = null, enSerie = null } = Astro.props

const ESTADOS = {
	disponible: { marca: '●', texto: 'Disponible', tenue: false },
	reservada: { marca: '○', texto: 'Reservada', tenue: false },
	vendida: { marca: '', texto: 'Vendida', tenue: true },
	'no-disponible': { marca: '', texto: 'No disponible', tenue: true },
}

const estado = ESTADOS[obra?.estado] || null
const vendida = obra?.estado === 'vendida'
const serie = obra?.serie?.slug ? obra.serie : enSerie?.serie || null
const posicion = enSerie?.posicion?.total > 1 ? enSerie.posicion : null

function medida(valor) {
	const numero = Number(valor)
	if (!(numero > 0)) return ''
	const texto = Number.isInteger(numero) ? String(numero) : String(numero).replace('.', ',')
	return `${texto} cm`
}

function precioVisible(obraActual) {
	if (!obraActual?.mostrarPrecio || obraActual.precio == null || !(Number(obraActual.precio) >= 0)) return ''
	return new Intl.NumberFormat('es-AR', { maximumFractionDigits: 2 }).format(Number(obraActual.precio))
}

const alto = medida(obra?.altoCm)
const ancho = medida(obra?.anchoCm)
const precio = precioVisible(obra)

const ficha = [
	obra?.anio != null && obra.anio !== '' ? ['Año', String(obra.anio)] : null,
	obra?.tecnica ? ['Técnica', obra.tecnica] : null,
	alto ? ['Alto', alto] : null,
	ancho ? ['Ancho', ancho] : null,
	!alto && !ancho && obra?.dimensiones ? ['Medidas', obra.dimensiones] : null,
	precio ? ['Precio', precio] : null,
].filter(Boolean)

function consultaWhatsapp(numero, titulo, anio) {
	const digitos = String(numero || '').replace(/\D/g, '')
	if (!digitos || !titulo) return ''
	const detalle = anio ? ` (${anio})` : ''
	const texto = `Hola, me interesa la obra '${titulo}'${detalle}. ¿Me pasás más info?`
	return `https://wa.me/${digitos}?text=${encodeURIComponent(texto)}`
}

const linkConsulta = consultaWhatsapp(whatsapp, obra?.titulo, obra?.anio)
const textoConsulta = vendida ? 'Consultar por obras similares' : estado ? 'Consultar por esta obra' : 'Consultar sobre esta obra'
const hrefSerie = serie?.slug ? rutaSerie(serie.slug) : ''
---

<div class="detalle__info">
	<div class="detalle__cabeza">
		{
			serie?.nombre && hrefSerie ? (
				<a class="detalle-serie" href={hrefSerie}>{serie.nombre}</a>
			) : (
				<p class="label">Obra</p>
			)
		}
		<h1 class="detalle-titulo titulo-obra">{obra.titulo}</h1>

		{
			ficha.length > 0 ? (
				<dl class="detalle-datos">
					{ficha.map(([etiqueta, valor]) => (
						<div class="detalle-dato">
							<dt>{etiqueta}</dt>
							<dd>{valor}</dd>
						</div>
					))}
				</dl>
			) : (
				<p class="detalle-pendiente">Ficha técnica en preparación</p>
			)
		}

		{
			estado && (
				<p class:list={['detalle-estado', estado.tenue && 'is-tenue']}>
					{estado.marca && <span aria-hidden="true">{estado.marca}</span>}
					{estado.texto}
				</p>
			)
		}

		{obra.descripcionCorta && <p class="detalle-texto">{obra.descripcionCorta}</p>}

		{envio && <p class="detalle-extra">{envio}</p>}

		{
			linkConsulta && (
				<a class="btn btn-outline detalle-consulta" href={linkConsulta} target="_blank" rel="noopener noreferrer">
					{textoConsulta}
					<span class="arrow" aria-hidden="true">→</span>
				</a>
			)
		}
	</div>

	{
		(anterior || siguiente || posicion) && (
			<nav class="detalle-nav" aria-label={serie ? 'Recorrer la serie' : 'Recorrer las obras'}>
				{posicion && (
					<p class="detalle-nav__posicion">
						{posicion.actual} de {posicion.total}
					</p>
				)}
				{anterior ? (
					<a class="detalle-nav__link" href={`/obras/${anterior.slug}`} rel="prev">
						<span class="detalle-nav__sentido">
							<span aria-hidden="true">←</span> Anterior
						</span>
						<span class="detalle-nav__titulo titulo-obra">{anterior.titulo}</span>
					</a>
				) : (
					<span />
				)}
				{siguiente && (
					<a class="detalle-nav__link detalle-nav__link--siguiente" href={`/obras/${siguiente.slug}`} rel="next">
						<span class="detalle-nav__sentido">
							Siguiente <span aria-hidden="true">→</span>
						</span>
						<span class="detalle-nav__titulo titulo-obra">{siguiente.titulo}</span>
					</a>
				)}
			</nav>
		)
	}
</div>

<style>
	.detalle-serie {
		color: var(--azul-medio);
		font-family: var(--font-ui);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		line-height: 1.4;
		text-transform: uppercase;
		text-decoration: none;
	}

	.detalle-serie:hover {
		color: var(--azul-profundo);
	}

	.detalle-serie:focus-visible {
		outline: 1px solid var(--azul-medio);
		outline-offset: 4px;
	}
</style>
