---
const { obra, whatsapp = '', envio = '' } = Astro.props

const ESTADOS = {
	disponible: { marca: '●', texto: 'Disponible', tenue: false },
	reservada: { marca: '○', texto: 'Reservada', tenue: false },
	vendida: { marca: '', texto: 'Vendida', tenue: true },
}

const CATEGORIAS = {
	pintura: 'Pintura',
	dibujo: 'Dibujo',
}

const estado = ESTADOS[obra?.estado] || null
const vendida = obra?.estado === 'vendida'
const categoria = CATEGORIAS[obra?.categoria] || ''

const datos = [
	obra?.anio != null && obra.anio !== '' ? ['Año', String(obra.anio)] : null,
	obra?.tecnica ? ['Técnica', obra.tecnica] : null,
	obra?.dimensiones ? ['Dimensiones', obra.dimensiones] : null,
	estado ? ['Estado', estado] : null,
].filter(Boolean)

function consultaWhatsapp(numero, titulo, anio) {
	const digitos = String(numero || '').replace(/\D/g, '')
	if (!digitos || !titulo) return ''
	const detalle = anio ? ` (${anio})` : ''
	const texto = `Hola, me interesa la obra '${titulo}'${detalle}. ¿Me pasás más info?`
	return `https://wa.me/${digitos}?text=${encodeURIComponent(texto)}`
}

const linkConsulta = consultaWhatsapp(whatsapp, obra?.titulo, obra?.anio)
---

<div class="detalle__info fade-in">
	<p class="label">Detalle de obra</p>
	<h1 class="detalle-titulo">{obra.titulo}</h1>

	{
		datos.length > 0 && (
			<dl class="detalle-datos">
				{datos.map(([etiqueta, valor]) => (
					<div class="detalle-dato">
						<dt>{etiqueta}</dt>
						<dd>
							{etiqueta === 'Estado' ? (
								<span class:list={['detalle-estado', valor.tenue && 'is-tenue']}>
									{valor.marca && <span aria-hidden="true">{valor.marca}</span>}
									{valor.texto}
								</span>
							) : (
								valor
							)}
						</dd>
					</div>
				))}
			</dl>
		)
	}

	{obra.descripcionCorta && <p class="detalle-texto">{obra.descripcionCorta}</p>}

	{
		linkConsulta && (
			<a
				class:list={['btn', 'btn-block', 'detalle-consulta', vendida ? 'btn-outline' : 'btn-solid']}
				href={linkConsulta}
				target="_blank"
				rel="noopener noreferrer"
			>
				{vendida ? 'Consultar por obras similares' : 'Consultar por esta obra'}
				<span class="arrow" aria-hidden="true">→</span>
			</a>
		)
	}

	<hr class="detalle-separa" />

	<dl>
		{
			categoria && (
				<div class="detalle-extra">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<rect x="4" y="5" width="16" height="14" fill="none" stroke="currentColor" stroke-width="1.25" />
					</svg>
					<dt>Categoría</dt>
					<dd>{categoria}</dd>
				</div>
			)
		}
		{
			obra.serie && (
				<div class="detalle-extra">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<rect x="7" y="7" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.25" />
						<rect x="4" y="4" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.25" />
					</svg>
					<dt>Serie</dt>
					<dd>{obra.serie}</dd>
				</div>
			)
		}
		{
			envio && (
				<div class="detalle-extra">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<rect x="2.5" y="8" width="11" height="8" fill="none" stroke="currentColor" stroke-width="1.25" />
						<path d="M13.5 12.5h5.5M16.5 10l2.5 2.5-2.5 2.5" fill="none" stroke="currentColor" stroke-width="1.25" />
					</svg>
					<dt>Envío / colección</dt>
					<dd>{envio}</dd>
				</div>
			)
		}
	</dl>
</div>
