---
const { obra, whatsapp = '', envio = '', anterior = null, siguiente = null } = Astro.props

const ESTADOS = {
	disponible: { marca: '●', texto: 'Disponible', tenue: false },
	reservada: { marca: '○', texto: 'Reservada', tenue: false },
	vendida: { marca: '', texto: 'Vendida', tenue: true },
}

const CATEGORIAS = {
	dibujo: 'Dibujo',
	instalacion: 'Instalación',
	'experimentacion-grafica': 'Experimentación gráfica',
	'obra-bidimensional': 'Obra bidimensional',
}

const estado = ESTADOS[obra?.estado] || null
const vendida = obra?.estado === 'vendida'
const categoria = CATEGORIAS[obra?.categoria] || ''

// La ficha técnica muestra solo los datos cargados; si no hay ninguno, una línea discreta.
const ficha = [
	obra?.anio != null && obra.anio !== '' ? ['Año', String(obra.anio)] : null,
	obra?.tecnica ? ['Técnica', obra.tecnica] : null,
	obra?.dimensiones ? ['Dimensiones', obra.dimensiones] : null,
].filter(Boolean)

function consultaWhatsapp(numero, titulo, anio) {
	const digitos = String(numero || '').replace(/\D/g, '')
	if (!digitos || !titulo) return ''
	const detalle = anio ? ` (${anio})` : ''
	const texto = `Hola, me interesa la obra '${titulo}'${detalle}. ¿Me pasás más info?`
	return `https://wa.me/${digitos}?text=${encodeURIComponent(texto)}`
}

const linkConsulta = consultaWhatsapp(whatsapp, obra?.titulo, obra?.anio)
const textoConsulta = vendida ? 'Consultar por cuadros similares' : estado ? 'Consultar por este cuadro' : 'Consultar sobre este cuadro'
---

<div class="detalle__info">
	<div class="detalle__cabeza">
		<p class="label">{obra.proyecto || 'Obra'}</p>
		<h1 class="detalle-titulo titulo-obra">{obra.titulo}</h1>

		{
			ficha.length > 0 ? (
				<dl class="detalle-datos">
					{ficha.map(([etiqueta, valor]) => (
						<div class="detalle-dato">
							<dt>{etiqueta}</dt>
							<dd>{valor}</dd>
						</div>
					))}
				</dl>
			) : (
				<p class="detalle-pendiente">Ficha técnica en preparación</p>
			)
		}

		{
			estado && (
				<p class:list={['detalle-estado', estado.tenue && 'is-tenue']}>
					{estado.marca && <span aria-hidden="true">{estado.marca}</span>}
					{estado.texto}
				</p>
			)
		}

		{obra.descripcionCorta && <p class="detalle-texto">{obra.descripcionCorta}</p>}

		{
			(categoria || envio) && (
				<p class="detalle-extra">{[categoria, envio].filter(Boolean).join(' · ')}</p>
			)
		}

		{
			linkConsulta && (
				<a
					class:list={['btn', 'detalle-consulta', vendida ? 'btn-outline' : 'btn-solid']}
					href={linkConsulta}
					target="_blank"
					rel="noopener noreferrer"
				>
					{textoConsulta}
					<span class="arrow" aria-hidden="true">→</span>
				</a>
			)
		}
	</div>

	{
		(anterior || siguiente) && (
			<nav class="detalle-nav" aria-label="Recorrer las obras">
				{anterior ? (
					<a class="detalle-nav__link" href={`/obras/${anterior.slug}`} rel="prev">
						<span class="detalle-nav__sentido">
							<span aria-hidden="true">←</span> Anterior
						</span>
						<span class="detalle-nav__titulo titulo-obra">{anterior.titulo}</span>
					</a>
				) : (
					<span />
				)}
				{siguiente && (
					<a class="detalle-nav__link detalle-nav__link--siguiente" href={`/obras/${siguiente.slug}`} rel="next">
						<span class="detalle-nav__sentido">
							Siguiente <span aria-hidden="true">→</span>
						</span>
						<span class="detalle-nav__titulo titulo-obra">{siguiente.titulo}</span>
					</a>
				)}
			</nav>
		)
	}
</div>
