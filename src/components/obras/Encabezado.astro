---
const { bajada } = Astro.props
---

<header class="encabezado contenedor grilla fade-in">
	<h1 class="page-title encabezado__titulo">Obras</h1>
	{bajada && <p class="encabezado__bajada">{bajada}</p>}
</header>

<style>
	.encabezado {
		row-gap: 1.25rem;
		padding-top: clamp(2.5rem, 6vw, 4.5rem);
	}

	.encabezado__titulo,
	.encabezado__bajada {
		grid-column: 1 / -1;
	}

	.encabezado__bajada {
		max-width: 36rem;
		color: var(--color-muted);
		font-size: 1.0625rem;
		line-height: 1.55;
	}

	@media (min-width: 64rem) {
		.encabezado__bajada {
			grid-column: 1 / 7;
		}
	}
</style>
