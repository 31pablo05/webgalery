---
import Bio from '../components/sobre/Bio.astro'
import Layout from '../layouts/Layout.astro'
import { fetchSobreMi } from '../lib/sanity.js'
import { textoDePortable } from '../lib/texto.js'

const { artista, contacto } = await fetchSobreMi()
const descripcion = artista.bioCorta || textoDePortable(artista.bioCompleta).slice(0, 200) || 'Biografía y trayectoria.'
const titulo = artista.nombre ? `Sobre mí — ${artista.nombre}` : 'Sobre mí'
const mismos = [contacto.instagram, contacto.vimeo, contacto.youtube].filter(Boolean)
const datos = artista.nombre
	? {
			'@context': 'https://schema.org',
			'@type': 'Person',
			name: artista.nombre,
			jobTitle: 'Artista visual',
			description: artista.bioCorta || undefined,
			url: new URL('/sobre-mi', Astro.site ?? Astro.url).href,
			...(mismos.length ? { sameAs: mismos } : {}),
		}
	: null
---

<Layout
	title={titulo}
	description={descripcion}
	ogImage={artista.retrato?.src}
	ogImageAlt={artista.retrato?.alt || artista.nombre}
	nombre={artista.nombre}
	subtitulo={artista.subtitulo}
	email={contacto.email}
	ciudad={contacto.ciudad}
	instagram={contacto.instagram}
	vimeo={contacto.vimeo}
	youtube={contacto.youtube}
	datos={datos}
>
	<Bio artista={artista} />
</Layout>
