---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/home/Hero.astro'
import FraseInicio from '../components/home/FraseInicio.astro'
import SerieDestacada from '../components/home/SerieDestacada.astro'
import SeriesDestacadas from '../components/home/SeriesDestacadas.astro'
import AudiovisualPapel from '../components/home/AudiovisualPapel.astro'
import SobreArtista from '../components/home/SobreArtista.astro'
import ContactoInicio from '../components/home/ContactoInicio.astro'
import {
	fetchDiapositivasHero,
	fetchDisciplinas,
	fetchFraseInicio,
	fetchHeroInicio,
	fetchInicio,
	fetchSeriePrincipal,
	fetchSeriesDestacadas,
	fetchVideoReciente,
	imagenDisponible,
	urlFor,
} from '../lib/sanity.js'

const [{ artista, configuracion }, diapositivas, frase, principal, disciplinas, video, textoHero] = await Promise.all([
	fetchInicio(),
	fetchDiapositivasHero(),
	fetchFraseInicio(),
	fetchSeriePrincipal(),
	fetchDisciplinas(),
	fetchVideoReciente(),
	fetchHeroInicio(),
])
// La serie principal ya tiene su banda: no se repite entre las destacadas (ninguna foto se repite en el Inicio).
const series = await fetchSeriesDestacadas({ excluir: principal?.slug })
const papel = disciplinas.find((disciplina) => disciplina.slug === 'obras-sobre-papel') || null
const clave = import.meta.env.PUBLIC_WEB3FORMS_KEY || ''

const nombre = artista?.nombre || ''
const titulo = nombre ? `${nombre} — ${artista?.subtitulo || 'Artista visual'}` : 'Inicio'
const imagenOg = diapositivas[0]?.imagen || (imagenDisponible(artista?.retrato) ? artista.retrato : null)
const ogImage = imagenOg ? urlFor(imagenOg).width(1200).height(630).url() : undefined
const mismos = [configuracion?.instagram, configuracion?.vimeo, configuracion?.youtube].filter(Boolean)
const datos = nombre
	? {
			'@context': 'https://schema.org',
			'@type': 'Person',
			name: nombre,
			jobTitle: 'Artista visual',
			url: new URL('/', Astro.site ?? Astro.url).href,
			...(mismos.length ? { sameAs: mismos } : {}),
		}
	: null
---

<Layout
	title={titulo}
	description={artista?.bioCorta || frase || 'Pintura, dibujo, instalación, performance y video.'}
	ogImage={ogImage}
	ogImageAlt={imagenOg?.alt || nombre || 'Inicio'}
	nombre={artista?.nombre}
	subtitulo={artista?.subtitulo}
	email={configuracion?.email}
	ciudad={configuracion?.ciudad}
	instagram={configuracion?.instagram}
	vimeo={configuracion?.vimeo}
	youtube={configuracion?.youtube}
	heroAzul={diapositivas.length > 0}
	datos={datos}
>
	<Hero diapositivas={diapositivas} texto={textoHero} />
	<FraseInicio frase={frase} />
	<SerieDestacada serie={principal} />
	<SeriesDestacadas series={series} />
	<AudiovisualPapel
		video={video}
		respaldo={
			imagenDisponible(artista?.heroAudiovisual?.imagen)
				? artista.heroAudiovisual.imagen
				: imagenDisponible(artista?.fotoTaller)
					? artista.fotoTaller
					: null
		}
		textoAudiovisual={artista?.heroAudiovisual?.bajada?.trim() || ''}
		papel={papel}
	/>
	<SobreArtista retrato={artista?.retrato} bio={artista?.bioCorta || ''} nombre={nombre} />
	<ContactoInicio
		clave={clave}
		whatsapp={configuracion?.whatsapp}
		email={configuracion?.email}
		instagram={configuracion?.instagram}
		vimeo={configuracion?.vimeo}
	/>
</Layout>
