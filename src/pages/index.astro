---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/home/Hero.astro'
import FraseInicio from '../components/home/FraseInicio.astro'
import ObraDestacada from '../components/home/ObraDestacada.astro'
import TresAccesos from '../components/home/TresAccesos.astro'
import SobreArtista from '../components/home/SobreArtista.astro'
import ContactoInicio from '../components/home/ContactoInicio.astro'
import {
	fetchDiapositivasHero,
	fetchDisciplinas,
	fetchFraseInicio,
	fetchInicio,
	fetchSeriePrincipal,
	fetchVideoReciente,
	imagenDisponible,
	urlFor,
} from '../lib/sanity.js'

const [{ artista, configuracion }, diapositivas, frase, destacada, disciplinas, video] = await Promise.all([
	fetchInicio(),
	fetchDiapositivasHero(),
	fetchFraseInicio(),
	fetchSeriePrincipal(),
	fetchDisciplinas(),
	fetchVideoReciente(),
])
const ilustraciones = disciplinas.find((disciplina) => disciplina.slug === 'ilustraciones') || null
// Acceso "Obras": un cuadro real como portada (la obra principal configurada). Ninguna foto se repite en el Inicio.
const fotoObras = imagenDisponible(configuracion?.obraPrincipal?.imagenPrincipal) ? configuracion.obraPrincipal.imagenPrincipal : null
const clave = import.meta.env.PUBLIC_WEB3FORMS_KEY || ''

const nombre = artista?.nombre || ''
const titulo = nombre ? `${nombre} — ${artista?.subtitulo || 'Artista visual'}` : 'Inicio'
const imagenOg = diapositivas[0]?.imagen || (imagenDisponible(artista?.retrato) ? artista.retrato : null)
const ogImage = imagenOg ? urlFor(imagenOg).width(1200).height(630).url() : undefined
---

<Layout
	title={titulo}
	description={artista?.bioCorta || frase || 'Pintura, dibujo, instalación, performance y video.'}
	ogImage={ogImage}
	ogImageAlt={imagenOg?.alt || nombre || 'Inicio'}
	nombre={artista?.nombre}
	subtitulo={artista?.subtitulo}
	email={configuracion?.email}
	ciudad={configuracion?.ciudad}
	instagram={configuracion?.instagram}
	vimeo={configuracion?.vimeo}
	youtube={configuracion?.youtube}
	heroAzul={diapositivas.length > 0}
>
	<Hero diapositivas={diapositivas} />
	<FraseInicio frase={frase} />
	<ObraDestacada obra={destacada} />
	<TresAccesos
		fotoObras={fotoObras}
		textoObras={artista?.bajadaGaleria || ''}
		ilustraciones={ilustraciones}
		video={video}
		respaldoAudiovisual={imagenDisponible(artista?.fotoTaller) ? artista.fotoTaller : null}
		textoAudiovisual={artista?.heroAudiovisual?.bajada?.trim() || ''}
	/>
	<SobreArtista retrato={artista?.retrato} bio={artista?.bioCorta || ''} nombre={nombre} />
	<ContactoInicio clave={clave} whatsapp={configuracion?.whatsapp} />
</Layout>
